graph LR
    subgraph msa [Inputs and MSAs]
        fasta_in[ ]
        msa_search[MSA search]
        pairing[Taxonomy pairing]
        fasta_in -->|af2,af3,boltz,rf3,protenix,openfold3,esmfold2| msa_search
        msa_search -->|af3,boltz,rf3,protenix,openfold3,esmfold2| pairing
        templates_in[ ]
        match_templates[Template matching]
        pairing -->|af3,boltz,openfold3| match_templates
        templates_in -->|af3,boltz,openfold3| match_templates
    end

    subgraph predict [Structure prediction]
        af2_run[AlphaFold2]
        af3_run[AlphaFold3]
        boltz_run[Boltz-2]
        rf3_run[RosettaFold3]
        protenix_run[Protenix]
        openfold3_run[OpenFold3]
        esmfold2_run[ESMFold2]
    end

    subgraph score [Scoring and clustering]
        confidence[Confidence and ipSAE]
        merge[Merge scores]
        engens[EnGens clustering]
        scores_out[ ]
        engens_out[ ]
        confidence -->|af2,af3,boltz,rf3,protenix,openfold3,esmfold2| merge
        merge -->|af2,af3,boltz,rf3,protenix,openfold3,esmfold2| scores_out
        merge -->|af2,af3,boltz,rf3,protenix,openfold3,esmfold2| engens
        engens -->|af2,af3,boltz,rf3,protenix,openfold3,esmfold2| engens_out
    end

    msa_search -->|af2| af2_run
    match_templates -->|af3| af3_run
    match_templates -->|boltz| boltz_run
    pairing -->|rf3| rf3_run
    pairing -->|protenix| protenix_run
    match_templates -->|openfold3| openfold3_run
    pairing -->|esmfold2| esmfold2_run
    af2_run -->|af2| confidence
    af3_run -->|af3| confidence
    boltz_run -->|boltz| confidence
    rf3_run -->|rf3| confidence
    protenix_run -->|protenix| confidence
    openfold3_run -->|openfold3| confidence
    esmfold2_run -->|esmfold2| confidence
