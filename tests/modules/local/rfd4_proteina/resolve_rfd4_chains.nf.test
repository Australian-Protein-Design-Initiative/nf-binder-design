nextflow_function {

    name "Test Function resolveRfd4Chains"
    script "modules/local/rfd4_proteina/rfd4_utils.nf"
    function "resolveRfd4Chains"

    tag "rfd4_proteina"
    tag "rfd4_utils"

    // The chain params default to boolean false, and false.toString() is the non-empty, therefore
    // truthy, string "false". Taking them at face value made every chain id literally "false", so
    // filter metrics were computed on a chain that does not exist and the binder sequence was read
    // from the wrong chain.
    test("unset chain params fall through to the A/B default") {
        when {
            function {
                """
                input[0] = [rfd4_target_chain: false, rfd4_binder_chain: false, contigs: false]
                """
            }
        }
        then {
            assert function.success
            assert function.result == ['A', 'B']
        }
    }

    test("unset chain params fall through to the contig derivation") {
        when {
            function {
                """
                input[0] = [rfd4_target_chain: false, rfd4_binder_chain: false, contigs: '50-120, /0, A17-131']
                """
            }
        }
        then {
            assert function.success
            assert function.result == ['A', 'B']
        }
    }

    test("explicit chain ids win over the default") {
        when {
            function {
                """
                input[0] = [rfd4_target_chain: 'C', rfd4_binder_chain: 'D', contigs: false]
                """
            }
        }
        then {
            assert function.success
            assert function.result == ['C', 'D']
        }
    }

    test("chain ids are read out of a YAML condition spec") {
        when {
            function {
                """
                input[0] = [
                    rfd4_target_chain: false,
                    rfd4_binder_chain: false,
                    contigs: false,
                    rfd4_config: "${projectDir}/tests/data/rfd4_proteina/spec_cd.yaml",
                ]
                """
            }
        }
        then {
            assert function.success
            assert function.result == ['C', 'A']
        }
    }

    // global_args holds shared defaults rather than a design, so a contig there is the
    // contig of every design that does not carry its own.
    test("a contig in global_args is read, from JSON as well as YAML") {
        when {
            function {
                """
                input[0] = [
                    rfd4_target_chain: false,
                    rfd4_binder_chain: false,
                    contigs: false,
                    rfd4_config: "${projectDir}/tests/data/rfd4_proteina/spec_global_contig.json",
                ]
                """
            }
        }
        then {
            assert function.success
            assert function.result == ['E', 'A']
        }
    }

    // The workflow reads one target and one binder chain for the whole run, so a spec whose
    // designs disagree has to stop rather than have the first design decide for the rest.
    test("a spec whose designs resolve to different chains stops the run") {
        when {
            function {
                """
                input[0] = [
                    rfd4_target_chain: false,
                    rfd4_binder_chain: false,
                    contigs: false,
                    rfd4_config: "${projectDir}/tests/data/rfd4_proteina/spec_conflicting.yaml",
                ]
                """
            }
        }
        then {
            assert !function.success
        }
    }

    test("a spec with no contig falls back to the A/B default") {
        when {
            function {
                """
                input[0] = [
                    rfd4_target_chain: false,
                    rfd4_binder_chain: false,
                    contigs: false,
                    rfd4_config: "${projectDir}/tests/data/rfd4_proteina/spec_no_contig.yaml",
                ]
                """
            }
        }
        then {
            assert function.success
            assert function.result == ['A', 'B']
        }
    }

    // --contigs is params mode and --rfd4_config is config mode, so they are mutually
    // exclusive in the workflow; if both ever reach here, the explicit contig wins.
    test("one explicit chain id is combined with the derived other") {
        when {
            function {
                """
                input[0] = [rfd4_target_chain: false, rfd4_binder_chain: 'Z', contigs: false]
                """
            }
        }
        then {
            assert function.success
            assert function.result == ['A', 'Z']
        }
    }
}
