// BINDCRAFT2 teardown tests run the process script on the host. Apptainer is
// disabled so the module's container (and its real `bindcraft`) is not used,
// and this directory's fake `bindcraft` is first on PATH.
apptainer.enabled = false
docker.enabled = false

process {
    withName: BINDCRAFT2 {
        container = null
        beforeScript = "export PATH=\"${projectDir}/tests/modules/local/bindcraft2/bin:\${PATH}\""
    }
}
