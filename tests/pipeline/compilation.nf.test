nextflow_pipeline {

    name "Pipeline compilation (DSL parses across Nextflow versions)"
    script "main.nf"

    tag "compilation"

    // These tests launch each method in `-preview` mode: Nextflow compiles every
    // included workflow/module and builds the DAG, but does not execute any process.
    // This catches DSL parser regressions (e.g. the 24.04.3 "Variable `Channel`
    // already defined in the process scope" error) without needing GPUs or containers.
    //
    // To check several Nextflow versions, run the suite once per version, e.g.:
    //   for v in 24.04.3 25.04.7 26.04.4 26.10.7; do NXF_VER=$v nf-test test tests/pipeline/compilation.nf.test; done

    test("rfd3 method compiles") {
        options "-preview"
        when {
            params {
                method = "rfd3"
                input_pdb = "${projectDir}/examples/pdl1-rfd3/input/PDL1.pdb"
                contigs = "[A18-132/0 50-120]"
                hotspot_res = "A56"
                rfd3_n_designs = 3
                outdir = "${outputDir}"
            }
        }
        then {
            assert workflow.success
        }
    }

    test("rfd method compiles") {
        options "-preview"
        when {
            params {
                method = "rfd"
                input_pdb = "${projectDir}/tests/data/rfd/glp1_peptide.pdb"
                contigs = "A1-30/0 10-20"
                hotspot_res = "A10"
                rfd_n_designs = 2
                outdir = "${outputDir}"
            }
        }
        then {
            assert workflow.success
        }
    }

    test("rfd_partial method compiles") {
        options "-preview"
        when {
            params {
                method = "rfd_partial"
                input_pdb = "${projectDir}/tests/data/rfd/glp1_peptide.pdb"
                contigs = "A1-30"
                hotspot_res = "A10"
                rfd_n_designs = 2
                outdir = "${outputDir}"
            }
        }
        then {
            assert workflow.success
        }
    }

    test("fold method compiles") {
        options "-preview"
        when {
            params {
                method = "fold"
                input = "${projectDir}/tests/data/fold_pulldown/monomer.fasta"
                methods = "boltz"
                skip_engens = true
                outdir = "${outputDir}"
            }
        }
        then {
            assert workflow.success
        }
    }

    test("fold_pulldown method compiles") {
        options "-preview"
        when {
            params {
                method = "fold_pulldown"
                targets = "${projectDir}/tests/data/fold_pulldown/targets.fasta"
                binders = "${projectDir}/tests/data/fold_pulldown/binders.fasta"
                methods = "boltz"
                outdir = "${outputDir}"
            }
        }
        then {
            assert workflow.success
        }
    }

    test("fold method compiles with af3") {
        options "-preview"
        when {
            params {
                method = "fold"
                input = "${projectDir}/tests/data/fold_pulldown/monomer.fasta"
                methods = "af3"
                // Empty placeholder: -preview only needs validation to find one model file
                af3_model_dir = "${projectDir}/tests/data/af3_dummy_weights"
                skip_engens = true
                outdir = "${outputDir}"
            }
        }
        then {
            assert workflow.success
        }
    }

    test("fold_pulldown method compiles with --complex_structures") {
        options "-preview"
        when {
            params {
                method = "fold_pulldown"
                complex_structures = "${projectDir}/tests/data/refold/design.pdb"
                binder_chains = "B"
                targets = "${projectDir}/tests/data/fold_pulldown/targets.fasta"
                methods = "boltz"
                outdir = "${outputDir}"
            }
        }
        then {
            assert workflow.success
        }
    }
    test("fold_pulldown method compiles with --complex_structures and no --targets") {
        options "-preview"
        when {
            params {
                method = "fold_pulldown"
                complex_structures = "${projectDir}/tests/data/refold/design.pdb"
                binder_chains = "B"
                target_chains = "A"
                methods = "boltz"
                outdir = "${outputDir}"
            }
        }
        then {
            assert workflow.success
        }
    }
    test("fold_pulldown method compiles with af3") {
        options "-preview"
        when {
            params {
                method = "fold_pulldown"
                targets = "${projectDir}/tests/data/fold_pulldown/targets.fasta"
                binders = "${projectDir}/tests/data/fold_pulldown/binders.fasta"
                methods = "af3"
                af3_model_dir = "${projectDir}/tests/data/af3_dummy_weights"
                outdir = "${outputDir}"
            }
        }
        then {
            assert workflow.success
        }
    }

    test("fold_pulldown method compiles with af3 germinal parity profile") {
        options "-preview -profile af3_germinal_parity"
        when {
            params {
                method = "fold_pulldown"
                targets = "${projectDir}/tests/data/fold_pulldown/targets.fasta"
                binders = "${projectDir}/tests/data/fold_pulldown/binders.fasta"
                methods = "af3"
                af3_model_dir = "${projectDir}/tests/data/af3_dummy_weights"
                // The profile turns on AF3's data pipeline, which makes af3_db_dir
                // required and checked for all nine database entries.
                af3_db_dir = "${projectDir}/tests/data/af3_dummy_dbs"
                outdir = "${outputDir}"
            }
        }
        then {
            assert workflow.success
        }
    }

    test("fold method compiles with af3 germinal parity profile") {
        options "-preview -profile af3_germinal_parity"
        when {
            params {
                method = "fold"
                input = "${projectDir}/tests/data/fold_pulldown/monomer.fasta"
                methods = "af3"
                af3_model_dir = "${projectDir}/tests/data/af3_dummy_weights"
                af3_db_dir = "${projectDir}/tests/data/af3_dummy_dbs"
                outdir = "${outputDir}"
            }
        }
        then {
            assert workflow.success
        }
    }

    test("fold method compiles with openfold3") {
        options "-preview"
        when {
            params {
                method = "fold"
                input = "${projectDir}/tests/data/fold_pulldown/monomer.fasta"
                methods = "openfold3"
                skip_engens = true
                outdir = "${outputDir}"
            }
        }
        then {
            assert workflow.success
        }
    }

    test("fold_pulldown method compiles with openfold3") {
        options "-preview"
        when {
            params {
                method = "fold_pulldown"
                targets = "${projectDir}/tests/data/fold_pulldown/targets.fasta"
                binders = "${projectDir}/tests/data/fold_pulldown/binders.fasta"
                methods = "openfold3"
                outdir = "${outputDir}"
            }
        }
        then {
            assert workflow.success
        }
    }

    test("fold method compiles with esmfold2") {
        options "-preview"
        when {
            params {
                method = "fold"
                input = "${projectDir}/tests/data/fold_pulldown/monomer.fasta"
                methods = "esmfold2"
                skip_engens = true
                outdir = "${outputDir}"
            }
        }
        then {
            assert workflow.success
        }
    }

    test("fold_pulldown method compiles with esmfold2") {
        options "-preview"
        when {
            params {
                method = "fold_pulldown"
                targets = "${projectDir}/tests/data/fold_pulldown/targets.fasta"
                binders = "${projectDir}/tests/data/fold_pulldown/binders.fasta"
                methods = "esmfold2"
                outdir = "${outputDir}"
            }
        }
        then {
            assert workflow.success
        }
    }

    test("fold method compiles with esmfold2 and esmfold2_fast") {
        options "-preview"
        when {
            params {
                method = "fold"
                input = "${projectDir}/tests/data/fold_pulldown/monomer.fasta"
                methods = "esmfold2,esmfold2_fast"
                skip_engens = true
                outdir = "${outputDir}"
            }
        }
        then {
            assert workflow.success
        }
    }

    test("fold_pulldown method compiles with esmfold2_fast") {
        options "-preview"
        when {
            params {
                method = "fold_pulldown"
                targets = "${projectDir}/tests/data/fold_pulldown/targets.fasta"
                binders = "${projectDir}/tests/data/fold_pulldown/binders.fasta"
                methods = "esmfold2_fast"
                outdir = "${outputDir}"
            }
        }
        then {
            assert workflow.success
        }
    }

    test("fold method compiles with templates") {
        options "-preview"
        when {
            params {
                method = "fold"
                input = "${projectDir}/tests/data/fold_pulldown/monomer.fasta"
                methods = "af3,boltz"
                af3_model_dir = "${projectDir}/tests/data/af3_dummy_weights"
                templates = "${projectDir}/tests/data/bindcraft/single"
                skip_engens = true
                outdir = "${outputDir}"
            }
        }
        then {
            assert workflow.success
        }
    }

    test("fold_pulldown method compiles with templates and binder templates") {
        options "-preview"
        when {
            params {
                method = "fold_pulldown"
                targets = "${projectDir}/tests/data/fold_pulldown/targets.fasta"
                binders = "${projectDir}/tests/data/fold_pulldown/binders.fasta"
                methods = "af3,boltz"
                af3_model_dir = "${projectDir}/tests/data/af3_dummy_weights"
                templates = "${projectDir}/tests/data/bindcraft/single/targetA.pdb"
                binder_templates = true
                outdir = "${outputDir}"
            }
        }
        then {
            assert workflow.success
        }
    }

    test("fold method rejects ids that collide after engine sanitisation") {
        tag "ids"
        options "-preview"
        when {
            params {
                method = "fold"
                // 'a+b' and 'ab' both become 'ab' for AF3 / OpenFold3 output paths
                input = "${projectDir}/tests/data/fold_ids/fold"
                methods = "boltz"
                skip_engens = true
                outdir = "${outputDir}"
            }
        }
        then {
            assert !workflow.success
            assert (workflow.stdout + workflow.stderr).any { it.contains("collide once AF3/OpenFold3 sanitise them") }
        }
    }

    test("fold_pulldown rejects a target and binder that sanitise to the same id") {
        tag "ids"
        options "-preview"
        when {
            params {
                method = "fold_pulldown"
                targets = "${projectDir}/tests/data/fold_ids/pulldown/targets.fasta"
                binders = "${projectDir}/tests/data/fold_ids/pulldown/binders.fasta"
                methods = "boltz"
                skip_engens = true
                outdir = "${outputDir}"
            }
        }
        then {
            assert !workflow.success
            assert (workflow.stdout + workflow.stderr).any { it.contains("shared by targets and binders once sanitised") }
        }
    }

    test("bindcraft method compiles (single PDB)") {
        options "-preview"
        when {
            params {
                method = "bindcraft"
                input_pdb = "${projectDir}/tests/data/bindcraft/single/targetA.pdb"
                target_chains = "A"
                bindcraft_n_traj = 2
                bindcraft_batch_size = 1
                outdir = "${outputDir}"
            }
        }
        then {
            assert workflow.success
        }
    }

    test("bindcraft method compiles (multi PDB glob)") {
        options "-preview"
        when {
            params {
                method = "bindcraft"
                input_pdb = "${projectDir}/tests/data/bindcraft/multi/*.pdb"
                target_chains = "A"
                bindcraft_n_traj = 2
                bindcraft_batch_size = 1
                outdir = "${outputDir}"
            }
        }
        then {
            assert workflow.success
        }
    }
    // germinal and rfd4_proteina, with the refold enabled, because every workflow
    // reaches the shared REFOLD subworkflow through its own `refold_engines` block and
    // these two were the methods a parser regression there went unnoticed in.
    test("germinal method compiles with a refold") {
        options "-preview"
        when {
            params {
                method = "germinal"
                germinal_config = "${projectDir}/examples/pdl1-germinal/configs/pdl1_vhh.yaml"
                germinal_pdb_dir = "${projectDir}/examples/pdl1-germinal/pdbs"
                germinal_n_traj = 2
                germinal_batch_size = 1
                refold_with = "boltz"
                outdir = "${outputDir}"
            }
        }
        then {
            assert workflow.success
        }
    }

    test("rfd4_proteina method compiles with a refold") {
        options "-preview"
        when {
            params {
                method = "rfd4_proteina"
                input_pdb = "${projectDir}/tests/data/rfd/glp1_peptide.pdb"
                contigs = "A1-30, /0, 10-20"
                hotspot_res = "A10"
                rfd4_n_designs = 2
                refold_with = "boltz"
                outdir = "${outputDir}"
            }
        }
        then {
            assert workflow.success
        }
    }

    test("rfd method compiles with a refold") {
        options "-preview"
        when {
            params {
                method = "rfd"
                input_pdb = "${projectDir}/tests/data/rfd/glp1_peptide.pdb"
                contigs = "A1-30/0 10-20"
                hotspot_res = "A10"
                rfd_n_designs = 2
                refold_with = "boltz"
                outdir = "${outputDir}"
            }
        }
        then {
            assert workflow.success
        }
    }

    // --refold_with defaults to '' (conf/refold.config). It once parsed to [''], which is
    // truthy, so every method that reaches the refold failed validation unless the user
    // asked for a refold. Each of these must compile with the refold left off.

    test("germinal method compiles without a refold") {
        options "-preview"
        when {
            params {
                method = "germinal"
                germinal_config = "${projectDir}/examples/pdl1-germinal/configs/pdl1_vhh.yaml"
                germinal_pdb_dir = "${projectDir}/examples/pdl1-germinal/pdbs"
                germinal_n_traj = 2
                germinal_batch_size = 1
                outdir = "${outputDir}"
            }
        }
        then {
            assert workflow.success
        }
    }

    test("rfd4_proteina method compiles without a refold") {
        options "-preview"
        when {
            params {
                method = "rfd4_proteina"
                input_pdb = "${projectDir}/tests/data/rfd/glp1_peptide.pdb"
                contigs = "A1-30, /0, 10-20"
                hotspot_res = "A10"
                rfd4_n_designs = 2
                outdir = "${outputDir}"
            }
        }
        then {
            assert workflow.success
        }
    }

    test("rfd method compiles without a refold") {
        options "-preview"
        when {
            params {
                method = "rfd"
                input_pdb = "${projectDir}/tests/data/rfd/glp1_peptide.pdb"
                contigs = "A1-30/0 10-20"
                hotspot_res = "A10"
                rfd_n_designs = 2
                outdir = "${outputDir}"
            }
        }
        then {
            assert workflow.success
        }
    }

    test("rfd3 method compiles without a refold") {
        options "-preview"
        when {
            params {
                method = "rfd3"
                input_pdb = "${projectDir}/examples/pdl1-rfd3/input/PDL1.pdb"
                contigs = "[A18-132/0 50-120]"
                hotspot_res = "A56"
                rfd3_n_designs = 3
                outdir = "${outputDir}"
            }
        }
        then {
            assert workflow.success
        }
    }
    test("bc2 method compiles (params mode)") {
        options "-preview"
        when {
            params {
                method = "bc2"
                input_pdb = "${projectDir}/tests/data/bc2/structures/targetA.pdb"
                target_chains = "A"
                hotspot_res = "A10,A12"
                bc2_n_traj = 3
                bc2_batch_size = 2
                outdir = "${outputDir}"
            }
        }
        then {
            assert workflow.success
        }
    }

    test("bc2 method compiles with foldseek") {
        options "-preview"
        when {
            params {
                method = "bc2"
                input_pdb = "${projectDir}/tests/data/bc2/structures/targetA.pdb"
                target_chains = "A"
                hotspot_res = "A10,A12,A14,A16"
                hotspot_subsample = 0.5
                do_foldseek_search = true
                bc2_n_traj = 2
                bc2_batch_size = 1
                outdir = "${outputDir}"
            }
        }
        then {
            assert workflow.success
        }
    }

    test("rfd4_proteina method compiles with foldseek clustering") {
        options "-preview"
        when {
            params {
                method = "rfd4_proteina"
                input_pdb = "${projectDir}/tests/data/rfd/glp1_peptide.pdb"
                contigs = "A1-30, /0, 10-20"
                do_foldseek_cluster = true
                rfd4_n_designs = 1
                outdir = "${outputDir}"
            }
        }
        then {
            assert workflow.success
        }
    }

    test("the retired --do_foldseek flag fails with the new name") {
        options "-preview"
        when {
            params {
                method = "rfd4_proteina"
                input_pdb = "${projectDir}/tests/data/rfd/glp1_peptide.pdb"
                contigs = "A1-30, /0, 10-20"
                do_foldseek = true
                outdir = "${outputDir}"
            }
        }
        then {
            assert workflow.failed
            assert workflow.stdout.any { it.contains("--do_foldseek_search") }
        }
    }

    test("bc2 method compiles (config mode, alias name)") {
        options "-preview"
        when {
            params {
                method = "bindcraft2"
                bc2_config = "${projectDir}/tests/data/bc2/campaign_relative.json"
                bc2_modality = "VHH"
                bc2_humanize = true
                bc2_set = "filters.i_pTM.threshold=0.8"
                bc2_n_traj = 2
                bc2_batch_size = 1
                outdir = "${outputDir}"
            }
        }
        then {
            assert workflow.success
        }
    }
}
