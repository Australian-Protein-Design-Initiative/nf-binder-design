// Local single-GPU workstation profile, auto-loaded by run.sh.
//
// Nextflow also auto-loads this for run-dual-gpu.sh, but that script passes
// nextflow.dual-gpu.config with -c, which is applied afterwards and so wins:
// its own withName: BINDCRAFT2 maxForks replaces the 1 set below.
//
// Only BINDCRAFT2 is capped. The executor queue is left alone so the config
// generation, gather and report tasks are not held up behind the GPU work.

params {
    gpu_devices = '0'
}

profiles {
    local {
        executor {
            name = 'local'
            queueSize = 1000
            pollInterval = '2 sec'
        }
        process {
            executor = 'local'
            stageInMode = 'symlink'
            maxRetries = 3
            cache = 'lenient'

            // One trajectory at a time. GPU exclusivity is enforced by
            // bin/gpu_lock.sh regardless; this just avoids queueing tasks that
            // would only block on the lock.
            withName: BINDCRAFT2 {
                maxForks = 1
            }
        }
    }
}
