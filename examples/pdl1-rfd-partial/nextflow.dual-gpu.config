// Local multi-GPU workstation profile.
//
// GPU exclusivity is enforced by bin/gpu_lock.sh, which each GPU task sources to
// claim a flock-backed slot for its lifetime. That claim is atomic, so no amount
// of simultaneous startup can put two tasks on one card, and the launch
// throttling earlier versions of this file relied on is no longer needed.

// Redeclare the existing default so this file's own withName closures below can resolve
// params.gpu_devices without Nextflow's "Unknown directive `params`" warning / "Unknown
// config attribute" error. --gpu_devices set on the CLI still overrides this as normal.
params {
    gpu_devices = ''
}

profiles {
    local {
        executor {
            name = 'local'
            queueSize = 1000
            // Latency between a GPU task finishing and the next being
            // dispatched -- idle time on a card that just went free.
            pollInterval = '2 sec'
            // No submitRateLimit: at '1/10sec' it capped the pipeline at 6
            // dispatches per minute regardless of how free the GPUs were. It
            // only ever existed to space out the old VRAM probe; the lock is
            // atomic, so there is no race left to space out.
        }
        process {
            executor = 'local'
            stageInMode = 'symlink'
            // We retry on failure to catch occasional cases where the process fails due to OOM,
            // as a result of a failure to allocate a dedicated GPU to the task.
            maxRetries = 3
            cache = 'lenient'

            withName: RFDIFFUSION {
                maxForks = params.gpu_devices ? params.gpu_devices.split(',').size() : null
            }
            withName: RFDIFFUSION_PARTIAL {
                maxForks = params.gpu_devices ? params.gpu_devices.split(',').size() : null
            }
            withName: AF2_INITIAL_GUESS {
                maxForks = params.gpu_devices ? params.gpu_devices.split(',').size() : null
            }
            withName: BINDCRAFT {
                maxForks = params.gpu_devices ? params.gpu_devices.split(',').size() : null
            }
            withName: BOLTZ {
                maxForks = params.gpu_devices ? params.gpu_devices.split(',').size() : null
            }
        }
    }
}
