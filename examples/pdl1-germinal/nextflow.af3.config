// Bind mounts for Germinal with structure_model: "af3".
//
// The germinal:*-af3 container bundles AlphaFold3 but not its model parameters
// or its public databases, so both are mounted in at the paths the Germinal
// config names (af3_model_dir / af3_db_dir). Those config values are
// in-container mount points and must not be changed to host paths -- see
// docs/workflows/germinal.md.
//
// Used by run-af3.sh, which sets these from $AF3_WEIGHTS and $AF3_DATABASES.

def af3_weights = System.getenv('AF3_WEIGHTS')
def af3_databases = System.getenv('AF3_DATABASES')

if (!af3_weights || !af3_databases) {
    throw new IllegalStateException(
        "AF3_WEIGHTS and AF3_DATABASES must be set when using nextflow.af3.config.\n" +
        "  AF3_WEIGHTS   directory holding exactly one af3.bin.zst\n" +
        "  AF3_DATABASES AlphaFold3 public databases (~630 GB)"
    )
}

process {
    withName: /^(GERMINAL|GERMINAL_PROCESS)$/ {
        containerOptions = "-B ${af3_weights}:/root/models -B ${af3_databases}:/root/public_databases"
    }
}
