// Run the containers with Docker rather than Apptainer.
//
// The rfd4-proteina image is built for linux/arm64 (DGX Spark GB10 and similar). On such a
// workstation Docker is usually the available runtime, and the image is in the local daemon
// rather than a registry, so Apptainer has nothing to pull.
apptainer.enabled = false
docker.enabled = true
docker.runOptions = '--gpus all'
