// Local multi-GPU workstation profile for the params-mode RFD4-Proteina run.
//
// The nextflow.config in this directory is auto-loaded and caps the local
// executor at one task. This file is passed with -c afterwards, so it wins:
// one RFD4_GENERATE task is allowed per GPU named in --gpu_devices.
//
// GPU placement is handled by bin/gpu_lock.sh. The lock decides which card a
// task runs on; maxForks decides how many generation tasks are in flight.

// Redeclare the existing default so this file's own withName closures below can resolve
// params.gpu_devices without Nextflow's "Unknown directive `params`" warning / "Unknown
// config attribute" error. --gpu_devices set on the CLI still overrides this as normal.
params {
    gpu_devices = ''
}

profiles {
    local {
        executor {
            name = 'local'
            queueSize = 1000
            // Latency between a GPU task finishing and the next being
            // dispatched -- idle time on a card that just went free.
            pollInterval = '2 sec'
        }
        process {
            executor = 'local'
            stageInMode = 'symlink'
            // Retry to absorb a transient CUDA OOM from two tasks landing on one card.
            maxRetries = 3
            cache = 'lenient'

            withName: RFD4_GENERATE {
                maxForks = params.gpu_devices ? params.gpu_devices.split(',').size() : null
            }
        }
    }
}
