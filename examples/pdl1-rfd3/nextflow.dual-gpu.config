// Local multi-GPU workstation profile.
//
// GPU placement is handled by bin/gpu_lock.sh, which each GPU task sources to
// claim a flock-backed slot for its lifetime. The claim is atomic, so no amount
// of simultaneous startup can put two tasks on the same card by accident, and
// slots fill breadth-first so an idle card is always preferred over a second
// slot on a busy one.
//
// The division of labour matters and is easy to get wrong: the LOCK decides
// WHERE a task runs, while maxForks and the executor's memory budget decide HOW
// MANY run.
//
// gpu_slots_per_device defaults to 1 -- one task per card, so VRAM contention
// is impossible. Where a process is known to leave headroom on the card, give
// it a second slot with ext.gpu_slots and raise its maxForks to match; a task
// holds its card idle for ~25 s of imports and checkpoint loading, and the
// second slot fills that gap. Do NOT raise maxForks without the matching slot:
// the surplus tasks are dispatched only to block on the lock while holding
// their memory reservation.

// Redeclare the existing default so this file's own withName closures below can resolve
// params.gpu_devices without Nextflow's "Unknown directive `params`" warning / "Unknown
// config attribute" error. --gpu_devices set on the CLI still overrides this as normal.
params {
    gpu_devices = ''
}

profiles {
    local {
        executor {
            name = 'local'
            // Allow CPU tasks (MPNN, MMseqs2, staging) alongside the GPU tasks.
            queueSize = 8
            // Latency between a GPU task finishing and the next being dispatched,
            // which lands directly on a card that has just gone free.
            pollInterval = '1 sec'
            // No submitRateLimit: at '1/10sec' it caps the pipeline at 6
            // dispatches a minute regardless of how free the GPUs are. It only
            // ever existed to space out the old VRAM probe.

            // Set these to match the machine. Host RAM is usually the real
            // ceiling on how many tasks can run at once, not VRAM: a
            // RosettaFold3 task peaks around 11.5 GB of host RAM against 3.4 GB
            // of VRAM. Under-declaring process memory lets Nextflow dispatch
            // more tasks than fit and the machine swaps.
            cpus = 20
            memory = '26 GB'
        }
        process {
            executor = 'local'
            stageInMode = 'symlink'
            // Retry to absorb transient CUDA OOM. This no longer papers over
            // allocation races, so repeated OOM here means the model genuinely
            // does not fit at the configured ext.gpu_slots.
            maxRetries = 3
            cache = 'lenient'

            // Memory figures are measured peak_rss for a 7-mer target with
            // 65-100 residue binders; scale them for larger targets.
            // Measured peak 3.4 GB VRAM on a 12 GB card, so two share it with
            // room to spare. maxForks is doubled to match the two slots.
            withName: RFDIFFUSION3 {
                memory = '11 GB'; cpus = 2
                ext.gpu_slots = 2
                maxForks = params.gpu_devices ? 2 * params.gpu_devices.split(',').size() : null
            }
            withName: ROSETTAFOLD3 {
                memory = '9 GB'; cpus = 2
                maxForks = params.gpu_devices ? params.gpu_devices.split(',').size() : null
            }
            withName: BOLTZ_COMPARE_COMPLEX {
                memory = '9 GB'
                maxForks = params.gpu_devices ? params.gpu_devices.split(',').size() : null
            }
            withName: BOLTZ_COMPARE_BINDER_MONOMER {
                memory = '9 GB'
                maxForks = params.gpu_devices ? params.gpu_devices.split(',').size() : null
            }
            // MPNN also claims a GPU (its inference engine defaults to cuda).
            // It is small and short, so two per card keeps the heavier
            // processes from waiting behind it.
            withName: MPNN {
                memory = '3 GB'
                ext.gpu_slots = 2
                maxForks = params.gpu_devices ? 2 * params.gpu_devices.split(',').size() : null
            }
        }
    }
}
