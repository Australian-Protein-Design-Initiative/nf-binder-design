/*
 * Fold-stack defaults for the design workflows.
 *
 * REFOLD drives the same fold stack that --method fold and --method fold_pulldown do,
 * so every engine's parameters have to exist in a design workflow as well. They used
 * to be declared in workflows/rfd4_proteina.nf, with a comment telling the next
 * workflow to copy the block; six copies of eighty parameters is how defaults drift
 * apart, so the block lives here and the workflows share it.
 *
 * Included only for the design workflows, because these are not neutral defaults -
 * they are what refolding a binder wants. --method fold and --method fold_pulldown
 * declare several of the same names with different values (af2_keep_models 'best'
 * rather than 'all', af2_model_preset monomer rather than multimer, n_predictions
 * unset, EnGens on), and a config declaration beats a workflow script's default, so
 * including this everywhere would silently change what those two entrypoints do.
 *
 * Workflow identity stays in the workflow: --design_name, --contigs, --input_pdb and
 * each workflow's own design-time engine parameters are declared there, as is
 * --refold_publish_dir, which names a different directory in each.
 */

params {

    // --- MSAs and how many structures per design ---

    msa_method = 'jackhmmer_af2'
    create_target_msa = false
    create_binder_msa = false
    use_msa_server = false

    // An A3M for the refold target, built elsewhere. Its first record must be the
    // target sequence being folded, which with --refold_target_fasta is the sequence
    // in that file and otherwise the one read back out of the designs. Mutually
    // exclusive with --create_target_msa.
    target_msa = false

    // Template structures for the refold, matched to the folded chains by sequence
    // (see FOLD_TEMPLATES / MATCH_FOLD_TEMPLATES). This is the plain fold-stack name
    // rather than a --refold_* one because in a design workflow the fold stack only
    // ever runs for the refold: --templates here means the refold's templates, and a
    // full-length target structure given here is what makes an engine model the parts
    // of the target that --refold_target_fasta added back.
    templates = false
    msa_subsample = false
    msa_subsample_include_full = true

    // 5 structures per design per engine. Each is a separate job of one sample with its
    // own seed, not one job of five samples, because the engines that batch samples
    // share a single trunk / recycling pass across them: five samples from one seed
    // vary only in the diffusion noise, while five seeds re-run the whole prediction.
    // The per-engine batch sizes below are what forces the one-sample-per-job split
    // (see subworkflows/local/*_fold.nf foldPredictionBatches). The disadvantage is
    // five model loads instead of one, which for Boltz is roughly 45 s of fixed cost
    // per sample.
    n_predictions = 5

    // --- per-engine refold copies ---
    //
    // One sample per job and a base seed, which together turn --n_predictions into
    // N seeds x 1 sample: the fold subworkflows split n_predictions into jobs of
    // batch_size samples and give job i seed base+i.
    //
    // These carry the refold_ prefix because the plain names mean something else at
    // design time in some workflows - rfd3's --rf3_batch_size is MPNN designs per RF3
    // task, not samples per fold job - and a workflow's parameters are one flat
    // namespace. The fold stack reads the prefixed name wherever it is declared (see
    // modules/local/fold/common/fold_params.nf), which is also why they cannot go in conf/refold.config:
    // that one is included for every entrypoint, and fold_params decides by asking
    // whether the prefixed name is declared at all, so --method fold would start
    // reading the refold's values instead of its own.
    refold_boltz_batch_size = 1
    refold_boltz_seed = 42
    refold_esmfold2_batch_size = 1
    refold_esmfold2_seeds = 42
    refold_chai1_batch_size = 1
    refold_chai1_seeds = 42
    refold_openfold3_batch_size = 1
    refold_openfold3_seeds = 42
    refold_af3_batch_size = 1

    // Prefixed for the reason above: rfd3 declares --rf3_batch_size, --rf3_num_steps
    // and --rf3_n_recycles for its own design-time RF3 step with different meanings,
    // so plain --rf3_* has no effect on the refold.
    refold_rf3_ckpt_path = '/models/foundry/rf3_foundry_01_24_latest_remapped.ckpt'
    refold_rf3_num_steps = 50
    refold_rf3_n_recycles = 10
    refold_rf3_batch_size = 1
    refold_rf3_early_stopping_plddt_threshold = 0.5
    refold_rf3_seed = 42

    // --- ranking, as in fold_pulldown (see bin/fold_pulldown_summarise.py) ---
    consensus_metric = 'ipsae'
    z_stat = 'max'
    z_scope = 'target'
    min_pool = 10

    // --- AF2 ---
    af2_db_path = '/mnt/datasets/alphafold/alphafold_20211129'
    af2_model_preset = 'multimer'
    af2_db_preset = 'full_dbs'
    af2_max_template_date = '2024-01-01'
    af2_random_seed = false
    af2_num_predictions_per_model = 1
    af2_uniref30_subpath = 'uniclust30/uniclust30_2018_08/uniclust30_2018_08'
    af2_uniprot_subpath = 'uniprot/uniprot.fasta'
    af2_pdb_seqres_subpath = 'pdb_seqres/pdb_seqres.txt'
    af2_mgnify_subpath = 'mgnify/mgy_clusters_2018_12.fa'
    af2_pdb70_subpath = 'pdb70/pdb70'
    af2_data_dir = '/app/alphafold'
    af2_keep_models = 'all'
    af2_no_relax = false
    af2_publish_pkl = true
    af2_monomer_model_preset = 'monomer_ptm'
    af2_chain_break_offset = 200

    // --- Protenix ---
    protenix_seeds = 42
    protenix_cycle = 10
    protenix_step = 200
    protenix_batch_size = 1
    protenix_model_name = 'protenix_base_default_v1.0.0'
    protenix_use_msa = true
    protenix_need_atom_confidence = true

    // --- local MSA databases, for --create_target_msa without --use_msa_server ---
    uniref30 = false
    colabfold_envdb = false

    // --- EnGens off: one report per design x engine is rarely what a design run wants ---
    skip_engens = true
    engens_dimred = 'umap'
    engens_clustering = 'hdbscan'
    engens_min_structures = 3
    engens_max_clusters = 10
    engens_gmm_ic = 'aic'
    engens_seed = false
    engens_superpose_method = 'blosum62'
    engens_featurizers = 'default,3di'

    // --- FoldSeek ---
    do_foldseek = false
    foldseek_search_max = false  // designs to search; defaults to --refold_max
    foldseek_database = 'CATH50'
    foldseek_databases_path = false
    foldseek_use_webserver = false
    foldseek_mode = '3diaa'
    foldseek_maxaccept = 1
    foldseek_gzip_output = false
    foldseek_include_html_output = false
    foldseek_cath_names_path = false
}
