/*
 * Defaults for --method fold_pulldown.
 *
 * In a config rather than at the top of workflows/fold_pulldown.nf because Nextflow does
 * not evaluate top-level `params.x = ...` in an included script, and main.nf includes
 * every method's workflow - the defaults declared there reached the workflow script
 * itself but never the subworkflows and modules it calls, which saw null.
 *
 * Selected by --method in nextflow.config, in place of conf/refold_fold_stack.config:
 * these two entrypoints run the same fold stack as a design workflow's refold, but
 * with their own values for several of the same names. Parameters shared with every
 * other entrypoint stay in nextflow.config and are not repeated here.
 */

params {
    // Which of the three fold-stack configs nextflow.config selected. main.nf checks
    // it against --method, so a --method the config-time branch could not see fails
    // the run rather than silently folding with another entrypoint's defaults.
    fold_stack = 'fold_pulldown'

    targets = false
    binders = false
    // Target-binder complexes as an alternative source of binder sequences: the binder
    // chain of each is folded against every --targets entry, and the complex is then the
    // reference each prediction is compared against (RMSD, TM-score, DockQ).
    complex_structures = false
    binder_chains = false
    target_chains = false
    help = false
    methods = 'boltz'
    msa_method = 'jackhmmer_af2'

    create_target_msa = false
    create_binder_msa = false
    n_predictions = 5

    // --- Ranking (see bin/fold_pulldown_summarise.py) ---
    consensus_metric = 'ipsae'
    z_stat = 'max'
    z_scope = 'target'
    min_pool = 10

    // --- AF2 (predict uses meta.n_chains=2 -> multimer; jackhmmer on targets stays monomer) ---
    af2_db_path = '/mnt/datasets/alphafold/alphafold_20211129'
    af2_model_preset = 'multimer'
    af2_db_preset = 'full_dbs'
    af2_max_template_date = '2024-01-01'
    af2_random_seed = false
    af2_num_predictions_per_model = 1
    af2_uniref30_subpath = 'uniclust30/uniclust30_2018_08/uniclust30_2018_08'
    af2_uniprot_subpath = 'uniprot/uniprot.fasta'
    af2_pdb_seqres_subpath = 'pdb_seqres/pdb_seqres.txt'
    af2_mgnify_subpath = 'mgnify/mgy_clusters_2018_12.fa'
    // pdb70 is reached only by the monomer presets (--methods af2_mono): multimer
    // template search uses hmmsearch over pdb_seqres instead of hhsearch over pdb70.
    af2_pdb70_subpath = 'pdb70/pdb70'
    // AF2 model parameters. The alphafold2:2.3.2-custom container bundles them at
    // /models/alphafold2, exposed as /app/alphafold/params by symlink, and
    // alphafold/model/data.py resolves `<data_dir>/params/params_<model>.npz` - so
    // the in-container default needs no host params dir. Point this at a host
    // AlphaFold download to override. (Falls back to af2_db_path if set false.)
    af2_data_dir = '/app/alphafold'
    af2_keep_models = 'all'
    af2_no_relax = false
    // AF2's result_model_*.pkl carry the full model output (distogram, MSA and
    // structure-module tensors) at ~90 MB each -- 860 MB per prediction, and by far
    // the largest thing the run writes. ptm/iptm/ranking_confidence appear ONLY in
    // there and nowhere in the published JSON, so they are published by default;
    // set false when the merged scores TSV is enough and disk is the binding
    // constraint. The pickles still exist in the Nextflow work dir either way.
    af2_publish_pkl = true
    // --- AF2 monomer chain-break mode (--methods af2_mono) ---
    // Fold a complex with the monomer weights: chains concatenated, separated only by a
    // jump in residue_index. AF2 clips relative positions at 32, so any offset above that
    // reads as "not covalently connected"; 200 is the dl_binder_design convention.
    af2_monomer_model_preset = 'monomer_ptm'
    af2_chain_break_offset = 200

    // --- Boltz ---
    use_msa_server = false
    templates = false
    target_msa = false  // external A3M for the target chain; bypasses the MSA search

    // --- RF3 ---
    rf3_ckpt_path = '/models/foundry/rf3_foundry_01_24_latest_remapped.ckpt'
    rf3_num_steps = 50
    rf3_n_recycles = 10
    rf3_batch_size = false
    rf3_early_stopping_plddt_threshold = 0.5
    rf3_seed = false

    // --- Protenix ---
    protenix_seeds = false
    protenix_cycle = 10
    protenix_step = 200
    protenix_batch_size = false
    protenix_model_name = 'protenix_base_default_v1.0.0'
    protenix_use_msa = true
    protenix_need_atom_confidence = true

    // --- MSA subsample (not supported for pulldown multimers) ---
    msa_subsample = false
    msa_subsample_include_full = true

    // EnGens off by default (would emit one report per complex = N x M)
    skip_engens = true
    engens_dimred = 'umap'
    engens_clustering = 'hdbscan'
    engens_min_structures = 3
    engens_max_clusters = 10
    engens_gmm_ic = 'aic'
    engens_seed = false
    engens_superpose_method = 'blosum62'
    engens_featurizers = 'default,3di'

    // --- ColabFold MSA ---
    uniref30 = false
    colabfold_envdb = false
}
