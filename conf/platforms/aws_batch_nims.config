// aws_batch_nims.config
// NIM-accelerated variant of the aws_batch profile, for the RFD method smoke
// test. Only RFDIFFUSION and DL_BINDER_DESIGN_PROTEINMPNN are NIM-backed here
// (rfdiffusion-nim-updated, proteinmpnn-nim-updated) - no NIM exists for the
// AF2 initial-guess step (see conf/platforms/aws_batch.config's own container
// vs. NVIDIA's AlphaFold2 NIM API - it has no way to seed a prediction from an
// existing structure, only predict from sequence), so that step and everything
// after it stays on the same baseline containers as the non-NIM profile.
//
// Same account/region/queue/workDir as aws_batch.config - see that file for
// details on those and on cliPath.

docker {
    enabled = true
}
apptainer {
    enabled = false
}

aws {
    region = 'us-east-1'
    batch {
        cliPath = '/opt/aws-cli/bin/aws'
    }
}

workDir = 's3://nvidia-nims-workdir/work'

params {
    ecr_base = '520168724997.dkr.ecr.us-east-1.amazonaws.com/nvidia-nims'
}

process {
    executor = 'awsbatch'
    queue = 'nvidia-nims-gpu-standard'
    resourceLabels = { ['project': 'nf-binder-design', 'profile': 'aws_batch_nims', 'runName': workflow.runName] }

    // rfdiffusion-nim-updated: same image NVIDIA publishes, rebuilt only to clear
    // its baked-in ENTRYPOINT (it starts its own HTTP server by default, which
    // would otherwise swallow Nextflow's task command - see modules/local/rfd/
    // rfdiffusion_nim.nf for what the task script does instead).
    // Generous 1h time limit: covers NIM startup/model load + one API call,
    // without risking a full 24h hang if something's wrong with the server
    // startup step.
    withName: RFDIFFUSION_NIM {
        container = "${params.ecr_base}:rfdiffusion-nim-updated"
        accelerator = 1
        cpus = 2
        memory = '16g'
        time = 1.hour
    }

    // proteinmpnn-nim-updated: same rebuild rationale as above. Needs a GPU
    // just like RFDIFFUSION_NIM - missing accelerator here caused the NIM's
    // own server to pass its basic HTTP health check (that part doesn't need
    // a GPU) but crash the moment an actual /predict request came in, closing
    // the connection mid-response (confirmed via the resulting
    // RemoteDisconnected error - no GPU-specific traceback was recoverable
    // since the server's own log isn't staged anywhere once the container
    // is torn down, but the failure pattern matches exactly).
    withName: DL_BINDER_DESIGN_PROTEINMPNN_NIM {
        container = "${params.ecr_base}:proteinmpnn-nim-updated"
        accelerator = 1
        cpus = 1
        memory = '8g'
        time = 1.hour
    }

    // Unchanged from the non-NIM profile - no NIM available/used for these.
    withName: AF2_INITIAL_GUESS {
        container = "${params.ecr_base}:af2-initial-guess"
        accelerator = 1
        cpus = 4
        memory = '16g'
        time = 30.minutes
    }

    withName: BINDCRAFT_SCORING_AF2IG {
        container = "${params.ecr_base}:bindcraft"
        cpus = 2
        memory = '4g'
        time = 30.minutes
    }

    withName: COMBINE_SCORES {
        executor = 'awsbatch'
        container = "${params.ecr_base}:nf-binder-design-utils"
    }

    withName: UNIQUE_ID {
        executor = 'awsbatch'
        container = "${params.ecr_base}:nf-binder-design-utils"
    }
}
