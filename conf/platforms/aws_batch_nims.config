// NIM-accelerated variant of the aws_batch profile. RFDIFFUSION and
// DL_BINDER_DESIGN_PROTEINMPNN are NIM-backed here; AF2 scoring stays on
// baseline containers (no AF2 NIM equivalent yet).

docker {
    enabled = true
}
apptainer {
    enabled = false
}

aws {
    region = 'us-east-1'
    batch {
        cliPath = '/opt/aws-cli/bin/aws'
    }
}

workDir = 's3://nvidia-nims-workdir/work'

params {
    ecr_base = '520168724997.dkr.ecr.us-east-1.amazonaws.com/nvidia-nims'
}

process {
    executor = 'awsbatch'
    queue = 'nvidia-nims-gpu-standard'
    resourceLabels = { ['project': 'nf-binder-design', 'profile': 'aws_batch_nims', 'runName': workflow.runName] }

    withName: RFDIFFUSION_NIM {
        container = "${params.ecr_base}:rfdiffusion-nim-updated"
        accelerator = 1
        cpus = 2
        memory = '16g'
        time = 1.hour
    }

    withName: DL_BINDER_DESIGN_PROTEINMPNN_NIM {
        container = "${params.ecr_base}:proteinmpnn-nim-updated"
        accelerator = 1
        cpus = 1
        memory = '8g'
        time = 1.hour
    }

    withName: THREAD_AND_RELAX {
        cpus = 1
        memory = '4g'
        time = 30.minutes
    }

    // Unchanged from the non-NIM profile - no NIM available/used for these.
    withName: AF2_INITIAL_GUESS {
        container = "${params.ecr_base}:af2-initial-guess"
        accelerator = 1
        cpus = 4
        memory = '16g'
        time = 30.minutes
    }

    withName: BINDCRAFT_SCORING_AF2IG {
        container = "${params.ecr_base}:bindcraft"
        cpus = 2
        memory = '4g'
        time = 30.minutes
    }

    withName: COMBINE_SCORES {
        executor = 'awsbatch'
        container = "${params.ecr_base}:nf-binder-design-utils"
    }

    withName: UNIQUE_ID {
        executor = 'awsbatch'
        container = "${params.ecr_base}:nf-binder-design-utils"
    }
}
