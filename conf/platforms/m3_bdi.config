/*
 * This is a configuration specific to users of the M3 / MASSIVE HPC cluster at Monash University 
 * in the Biomolecular Discovery Institute (BDI) with access to the `bdi` and `m3h` partitions.
 *
 * Other M3 users should use the `m3.config` instead.
 */

includeConfig "${projectDir}/conf/platforms/monash_containers.config"

// params {
//  models_basepath = '/scratch2/yt41/apdi/nf-binder-design/models'

    /*
    container_basepath = '/scratch2/yt41/apdi/nf-binder-design/containers'
    containers {
        rfdiffusion = "${container_basepath}/rfdiffusion_pytorch2407-weights-b44206a.sif"
        silenttools = "${container_basepath}/proteinmpnn_fastrelax_latest.sif"
        dl_binder_design_proteinmpnn = "${container_basepath}/proteinmpnn_fastrelax_latest.sif"
        af2_initial_guess = "${container_basepath}/af2_initial_guess_nv-cuda12.sif"
        get_contigs = "${container_basepath}/proteinmpnn_fastrelax_latest.sif"
        renumber_residues = "${container_basepath}/proteinmpnn_fastrelax_latest.sif"
        combine_scores = "${container_basepath}/ghcr.io_australian-protein-design-initiative_containers_mdanalysis_2.8.0.sif"
    }
    */
//}

params.slurm_account = false

def account_option = (params.slurm_account ? " --account=${params.slurm_account}" : '')
def exclude_option = ' --exclude=m3t100'
def common_options = "${account_option}${exclude_option}"

def gpu_options = "--gres=gpu:1 --partition=bdi --qos=bdiq ${common_options}"
def gpu_m3h_options = "--gres=gpu:1 --partition=m3h --qos=m3h ${common_options}"
def gpu_generic_options = "--gres=gpu:1 --partition=gpu ${common_options}"
def cpu_short_options = "--partition=comp --qos=shortq ${common_options}"
def cpu_comp_options = "--partition=comp ${common_options}"
def cpu_genomics_options = "--partition=genomics --qos=genomics ${common_options}"

def random_choice(choices) {
    return choices[new Random().nextInt(choices.size())]
}

executor {
    $slurm {
        queueSize = 200
        pollInterval = '30 sec'
        queueStatInterval = '10m'
    }
}

process {
    executor = 'slurm'
    stageInMode = 'symlink'
    errorStrategy = 'retry'
    maxRetries = 1
    cache = 'lenient'

    withName: UNIQUE_ID {
        executor = 'local'
    }

    withName: GET_CONTIGS {
        //container = params.containers.get_contigs
        executor = 'local'
    }

    withName: RENUMBER_RESIDUES {
        //container = params.containers.renumber_residues
        executor = 'local'
    }

    withName: FILTER_DESIGNS {
        executor = 'local'
    }

    withName: RFD3_FILTER_DESIGNS {
        executor = 'local'
    }

    withName: 'COMBINE_RFD3_SCORES' {
        executor = 'local'
    }

    withName: AF2IG_SCORE_FILTER {
        executor = 'local'
    }

    withName: COMBINE_SCORES {
        //container = params.containers.combine_scores
        executor = 'local'
    }

    withName: RFDIFFUSION {
        //container = params.containers.rfdiffusion

        // clusterOptions = gpu_m3h_options
        clusterOptions = gpu_options
        time = 2.hours

        accelerator = 1

        memory = '64g'
        cpus = 16
    }

    withName: RFDIFFUSION_PARTIAL {
        //container = params.containers.rfdiffusion

        // clusterOptions = gpu_m3h_options
        clusterOptions = gpu_options
        time = 30.minutes

        accelerator = 1
        memory = '64g'
        cpus = 16
    }

    withName: GENERATE_RFD3_CONFIG {
        executor = 'local'
    }

    withName: RFDIFFUSION3 {
        accelerator = 1
        clusterOptions = gpu_options
        time = 2.hours
        memory = '32g'
        cpus = 2
    }

    withName: MPNN {
        clusterOptions = cpu_short_options
        time = 30.minutes
        memory = '4g'
        cpus = 1
    }

    withName: ROSETTAFOLD3 {
        accelerator = 1
        clusterOptions = gpu_options
        time = { 15.minutes * Math.max(1, (params.rf3_batch_size ?: 1) as int) }
        memory = '64g'
        cpus = 2
    }

    withName: RFD3_RMSD {
        executor = 'local'
    }

    withName: DL_BINDER_DESIGN_PROTEINMPNN {
        //container = params.containers.dl_binder_design_proteinmpnn

        // CPU only
        // clusterOptions = cpu_genomics_options

        clusterOptions = cpu_short_options
        time = 30.minutes

        memory = '4g'
        cpus = 1
    }

    withName: AF2_INITIAL_GUESS {
        //container = params.containers.af2_initial_guess
        accelerator = 1

        // H100-80G
        // clusterOptions = gpu_m3h_options

        // BDI: A100/A40
        clusterOptions = gpu_options

        time = 2.hours

        memory = '64g'
        cpus = 16
    }

    withName: MMSEQS_COLABFOLDSEARCH {
        clusterOptions = cpu_comp_options
        time = 4.hours
        memory = '64g'
        cpus = 16

        // clusterOptions = cpu_genomics_options
        //time = 4.hours
        //memory = '128g' // '360g'
        //cpus = 24       // 48
        // Load index into RAM
        //ext.args = "--db-load-mode 2"
    }

    withName: BOLTZ {
        accelerator = 1

        // GPU partition
        // clusterOptions = gpu_generic_options

        // H100-80G
        // clusterOptions = gpu_m3h_options

        // BDI: A100/A40
        clusterOptions = gpu_options

        time = 1.hours
        memory = '64g'
        cpus = 2
    }

    withName: BOLTZ_COMPARE_COMPLEX {
        accelerator = 1

        // GPU partition
        // clusterOptions = gpu_generic_options

        // H100-80G
        // clusterOptions = gpu_m3h_options

        // BDI: A100/A40
        clusterOptions = gpu_options

        time = 2.hours
        memory = '64g'
        cpus = 2
    }

    withName: BOLTZ_COMPARE_BINDER_MONOMER {
        accelerator = 1

        // GPU partition
        // clusterOptions = gpu_generic_options

        // H100-80G
        // clusterOptions = gpu_m3h_options

        // BDI: A100/A40
        clusterOptions = gpu_options

        time = 1.hours
        memory = '64g'
        cpus = 2
    }

    // fold / fold_pulldown processes - mirrors conf/platforms/m3.config, with GPU
    // jobs on the BDI partition (gpu_options). Keep the selector names in step
    // with m3.config; tests/bin/test_withname_coverage.py checks both files.
    withName: ALPHAFOLD2_JACKHMMER_MSA {
        // Not shortq: it caps at 30 min and full_dbs MSA generation needs hours.
        clusterOptions = cpu_comp_options
        time = 8.hours
        memory = '64g'
        cpus = 8
    }

    withName: ALPHAFOLD2 {
        accelerator = 1
        clusterOptions = gpu_options
        time = 2.hours
        memory = '64g'
        cpus = 4
    }

    withName: FOLD_PULLDOWN_REPORTING {
        executor = 'local'
    }

    withName: FOLD_PULLDOWN_MERGE_SCORES {
        executor = 'local'
    }

    withName: SINGLE_SEQ_A3M {
        executor = 'local'
        cpus = 1
        memory = '1g'
    }

    withName: MATCH_FOLD_TEMPLATES {
        executor = 'local'
        cpus = 1
        memory = '4g'
    }

    withName: 'FOLD_ASSEMBLE_AF2_MULTIMER_MSAS|AF2_STAGE_COLABFOLD_MULTIMER_MSAS' {
        executor = 'local'
        cpus = 1
        memory = '8g'
    }

    withName: COLABFOLD_A3M_TO_AF2_MSAS {
        executor = 'local'
    }

    withName: AF2_MSAS_TO_A3M {
        executor = 'local'
    }

    withName: 'FOLD_CREATE_BOLTZ_YAML|FOLD_CREATE_BOLTZ_YAML_COMPLEX|FOLD_PARSE_BOLTZ_CONFIDENCE|FOLD_SCORE_AF2|SPLIT_COMPLEX_FASTA|ANNOTATE_MSA' {
        executor = 'local'
        cpus = 1
    }

    withName: '.*:FOLD_PARSE_CONFIDENCE' {
        executor = 'local'
        cpus = 1
    }

    withName: 'FOLD_MERGE_SCORES' {
        executor = 'local'
        cpus = 1
    }

    withName: ENGENS_STAGE_STRUCTURE {
        executor = 'local'
    }

    withName: ENGENS {
        // CPU-only Quarto + EnGens report; no GPU.
        clusterOptions = cpu_comp_options
        time = 2.hours
        memory = '16g'
        cpus = 4
    }

    withName: 'GENERATE_RF3_FOLD_INPUT.*' {
        executor = 'local'
    }

    withName: RF3_FOLD {
        accelerator = 1
        clusterOptions = gpu_options
        time = { 15.minutes * Math.max(1, (params.rf3_batch_size ?: params.n_predictions ?: 5) as int) }
        memory = '64g'
        cpus = 2
    }

    withName: 'GENERATE_PROTENIX_INPUT.*' {
        executor = 'local'
    }

    withName: PROTENIX_FOLD_PROCESS {
        accelerator = 1
        clusterOptions = gpu_options
        time = { 30.minutes + 6.minutes * Math.max(1, (params.protenix_batch_size ?: params.n_predictions ?: 5) as int) }
        memory = '64g'
        cpus = 2
    }

    withName: 'GENERATE_AF3_INPUT.*' {
        executor = 'local'
    }

    withName: ALPHAFOLD3_PROCESS {
        accelerator = 1
        clusterOptions = gpu_options
        time = { 30.minutes + 5.minutes * Math.max(1, (params.af3_batch_size ?: params.n_predictions ?: 5) as int) }
        memory = '64g'
        cpus = 4
    }

    withName: 'GENERATE_OPENFOLD3_INPUT.*' {
        executor = 'local'
    }

    withName: OPENFOLD3_PROCESS {
        accelerator = 1
        clusterOptions = gpu_options
        time = { 30.minutes + 5.minutes * Math.max(1, (params.openfold3_batch_size ?: params.n_predictions ?: 5) as int) }
        memory = '64g'
        cpus = 4
    }

    withName: GENERATE_ESMFOLD2_INPUT_COMPLEX {
        executor = 'local'
    }

    withName: 'ESMFOLD2_PROCESS|ESMFOLD2_FAST_PROCESS' {
        accelerator = 1
        clusterOptions = gpu_options
        time = { 45.minutes + 10.minutes * Math.max(1, (params.esmfold2_batch_size ?: params.n_predictions ?: 5) as int) }
        memory = '64g'
        cpus = 4
    }

    withName: BINDCRAFT_CREATE_SETTINGS {
        executor = 'local'
    }

    withName: BINDCRAFT {
        accelerator = 1
        time = 2.hours
        memory = '16g'
        cpus = 2

        // H100-80G
        // clusterOptions = gpu_m3h_options

        // BDI: A100/A40
        clusterOptions = gpu_options
    }

    withName: /^(GERMINAL|GERMINAL_PROCESS)$/ {
        accelerator = 1
        time = 24.hours
        memory = '48g'
        cpus = 8

        // BDI partition requires an account with bdiq QOS access (eg yt41)
        clusterOptions = gpu_options
    }

    withName: GERMINAL_MERGE {
        executor = 'local'
        time = 30.minutes
        memory = '1g'
        cpus = 1
    }

    withName: BOLTZGEN_DESIGN {
        accelerator = 1
        time = 30.minutes
        memory = '16g'
        cpus = 2
        clusterOptions = gpu_options
    }

    withName: BOLTZGEN_INVERSE_FOLDING {
        accelerator = 1
        time = 30.minutes
        memory = '8g'
        cpus = 2
        clusterOptions = gpu_options
    }

    withName: BOLTZGEN_FOLDING {
        accelerator = 1
        time = 30.minutes
        memory = '16g'
        cpus = 2
        clusterOptions = gpu_options
    }

    withName: BOLTZGEN_DESIGN_FOLDING {
        accelerator = 1
        time = 30.minutes
        memory = '16g'
        cpus = 2
        clusterOptions = gpu_options
    }

    withName: BOLTZGEN_MERGE {
        executor = 'local'
        time = 30.minutes
        memory = '1g'
        cpus = 1
    }

    withName: BOLTZGEN_ANALYSIS {
        time = 30.minutes
        memory = '64g'
        cpus = 8
        clusterOptions = gpu_options
    }

    withName: BOLTZGEN_FILTERING {
        time = 30.minutes
        memory = '4g'
        cpus = 1
        clusterOptions = gpu_options
    }

    // FoldSeek processes
    withName: FOLDSEEK_DOWNLOAD_DB {
        executor = 'local'
        time = 2.hours
        memory = '8g'
        cpus = 2
    }

    withName: FOLDSEEK_PREPARE_QUERIES {
        time = 30.minutes
        memory = '4g'
        cpus = 2
    }

    withName: FOLDSEEK_LOCAL_SEARCH {
        time = 4.hours
        memory = '16g'
        cpus = 8
    }

    withName: FOLDSEEK_REMOTE_SEARCH {
        executor = 'local'
        time = 2.hours
        memory = '4g'
        cpus = 1
    }

    withName: FOLDSEEK_DOWNLOAD_CATH_NAMES {
        executor = 'local'
        time = 30.minutes
        memory = '1g'
        cpus = 1
        errorStrategy = 'ignore'
    }

    withName: FOLDSEEK_ANNOTATE_CATH {
        time = 30.minutes
        memory = '4g'
        cpus = 2
        errorStrategy = 'ignore'
    }
}

// Apptainer specific settings
apptainer {
    enabled = true
    autoMounts = true
    pullTimeout = 3.hours

    // --nv to enable NVIDIA GPU support
    // See conf/platforms/m3.config for why BOTH AlphaFold trees are bound: the
    // sequence DBs under /mnt/datasets/alphafold are symlinks into /mnt/reference.
    runOptions = "--nv --cleanenv --env PYTHONNOUSERSITE=1 -B \$HOME -B /scratch2 -B /fs04 -B /mnt/datasets/alphafold -B /mnt/reference/alphafold"
    envWhitelist = ['BOLTZ_CACHE']
}

// AlphaFold2 sequence databases on M3 - see conf/platforms/m3.config for why these
// are required as flags even when MSAs come from ColabFold.
params {
    af2_db_path = '/mnt/datasets/alphafold/alphafold_20211129'
    af2_uniref30_subpath = 'uniclust30/uniclust30_2018_08/uniclust30_2018_08'
    af2_mgnify_subpath = 'mgnify/mgy_clusters_2018_12.fa'
    af2_uniprot_subpath = 'uniprot/uniprot.fasta'
    af2_pdb_seqres_subpath = 'pdb_seqres/pdb_seqres.txt'
    af2_pdb70_subpath = 'pdb70/pdb70'
}
