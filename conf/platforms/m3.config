/*
 * This is a configuration specific to users of the M3 / MASSIVE HPC cluster at Monash University.
 */

includeConfig "${projectDir}/conf/platforms/monash_containers.config"

params.slurm_account = false

def account_option = (params.slurm_account ? " --account=${params.slurm_account}" : '')
def exclude_option = ' --exclude=m3t100'
def common_options = "${account_option}${exclude_option}"

def gpu_options = "--gres=gpu:1 --partition=gpu ${common_options}"
def gpu_m3h_options = "--gres=gpu:1 --partition=m3h --qos=m3h ${common_options}"
def gpu_bdi_options = "--gres=gpu:1 --partition=bdi --qos=bdiq ${common_options}"
def cpu_short_options = "--partition=comp --qos=shortq ${common_options}"
def cpu_comp_options = "--partition=comp ${common_options}"
def cpu_genomics_options = "--partition=genomics --qos=genomics ${common_options}"

def random_choice(choices) {
    return choices[new Random().nextInt(choices.size())]
}

executor {
    $slurm {
        queueSize = 200
        pollInterval = '30 sec'
        queueStatInterval = '10m'
    }
}

process {
    executor = 'slurm'
    stageInMode = 'symlink'
    errorStrategy = 'retry'
    maxRetries = 1
    cache = 'lenient'

    withName: UNIQUE_ID {
        executor = 'local'
    }

    withName: GET_CONTIGS {
        //container = params.containers.get_contigs
        executor = 'local'
    }

    withName: RENUMBER_RESIDUES {
        //container = params.containers.renumber_residues
        executor = 'local'
    }

    withName: FILTER_DESIGNS {
        executor = 'local'
    }

    withName: RFD3_FILTER_DESIGNS {
        executor = 'local'
    }

    withName: 'COMBINE_RFD3_SCORES' {
        executor = 'local'
    }

    withName: AF2IG_SCORE_FILTER {
        executor = 'local'
    }

    withName: COMBINE_SCORES {
        //container = params.containers.combine_scores
        executor = 'local'
    }

    withName: RFDIFFUSION {
        //container = params.containers.rfdiffusion

        // GPU partition
        clusterOptions = gpu_options

        // H100-80G
        // clusterOptions = gpu_m3h_options

        // BDI: A100/A40
        // clusterOptions = gpu_bdi_options

        time = 2.hours
        accelerator = 1

        memory = '64g'
        cpus = 16
    }

    withName: RFDIFFUSION_PARTIAL {
        //container = params.containers.rfdiffusion

        // GPU partition
        clusterOptions = gpu_options

        // H100-80G
        // clusterOptions = gpu_m3h_options

        // BDI: A100/A40
        // clusterOptions = gpu_bdi_options

        time = 30.minutes
        accelerator = 1
        memory = '64g'
        cpus = 16
    }

    withName: GENERATE_RFD3_CONFIG {
        executor = 'local'
    }

    withName: RFDIFFUSION3 {
        accelerator = 1
        clusterOptions = gpu_options
        time = 2.hours
        memory = '32g'
        cpus = 2
    }

    withName: MPNN {
        clusterOptions = cpu_short_options
        time = 30.minutes
        memory = '4g'
        cpus = 1
    }

    withName: ROSETTAFOLD3 {
        accelerator = 1
        clusterOptions = gpu_options
        time = { 15.minutes * Math.max(1, (params.rf3_batch_size ?: 1) as int) }
        memory = '64g'
        cpus = 2
    }

    withName: RFD3_RMSD {
        executor = 'local'
    }

    withName: DL_BINDER_DESIGN_PROTEINMPNN {
        //container = params.containers.dl_binder_design_proteinmpnn

        // CPU only
        // clusterOptions = cpu_genomics_options
        clusterOptions = cpu_short_options
        time = 30.minutes

        memory = '4g'
        cpus = 1
    }

    withName: AF2_INITIAL_GUESS {
        //container = params.containers.af2_initial_guess
        accelerator = 1

        // GPU partition
        clusterOptions = gpu_options

        // H100-80G
        // clusterOptions = gpu_m3h_options

        // BDI: A100/A40
        // clusterOptions = gpu_bdi_options

        time = 2.hours

        memory = '64g'
        cpus = 16
    }

    withName: CREATE_BOLTZ_YAML {
        executor = 'local'
    }

    withName: PARSE_BOLTZ_CONFIDENCE_JSON {
        executor = 'local'
    }

    withName: BOLTZ_PULLDOWN_REPORTING {
        executor = 'local'
    }

    withName: MMSEQS_COLABFOLDSEARCH {
        // comp partition
        clusterOptions = cpu_comp_options
        time = 4.hours
        memory = '64g'
        cpus = 16

    // genomics partition
    // clusterOptions = cpu_genomics_options
    //time = 4.hours
    //memory = '128g' // '360g'
    //cpus = 24       // 48
    // Load index into RAM
    //ext.args = "--db-load-mode 2"
    }

    withName: BOLTZ {
        accelerator = 1

        // GPU partition
        clusterOptions = gpu_options

        // BDI: A100/A40
        // clusterOptions = gpu_bdi_options

        time = 1.hours
        memory = '64g'
        cpus = 2
    }

    withName: 'BOLTZ_PULLDOWN:BOLTZ' {
        accelerator = 1

        // GPU partition
        clusterOptions = gpu_options

        // BDI: A100/A40
        // clusterOptions = gpu_bdi_options

        time = 1.hours
        memory = '64g'
        cpus = 2
    }


    withName: BOLTZ_COMPARE_COMPLEX {
        accelerator = 1

        // GPU partition
        clusterOptions = gpu_options

        // BDI: A100/A40
        // clusterOptions = gpu_bdi_options

        time = 2.hours
        memory = '64g'
        cpus = 2
    }

    withName: BOLTZ_COMPARE_BINDER_MONOMER {
        accelerator = 1

        // GPU partition
        clusterOptions = gpu_options

        // BDI: A100/A40
        // clusterOptions = gpu_bdi_options

        time = 1.hours
        memory = '64g'
        cpus = 2
    }

    withName: BINDCRAFT_CREATE_SETTINGS {
        executor = 'local'
    }

    withName: BINDCRAFT {
        accelerator = 1
        time = 2.hours
        memory = '16g'
        cpus = 2

        // GPU partition
        clusterOptions = gpu_options

        // BDI: A100/A40
        // clusterOptions = gpu_bdi_options
    }

    withName: /^(GERMINAL|GERMINAL_PROCESS)$/ {
        accelerator = 1
        time = 24.hours
        memory = '48g'
        cpus = 8
        clusterOptions = gpu_options
    }

    withName: GERMINAL_MERGE {
        executor = 'local'
        time = 30.minutes
        memory = '1g'
        cpus = 1
    }

    withName: BOLTZGEN_DESIGN {
        accelerator = 1
        time = 30.minutes
        memory = '16g'
        cpus = 2
        clusterOptions = gpu_options
    }

    withName: BOLTZGEN_INVERSE_FOLDING {
        accelerator = 1
        time = 30.minutes
        memory = '8g'
        cpus = 2
        clusterOptions = gpu_options
    }

    withName: BOLTZGEN_FOLDING {
        accelerator = 1
        time = 30.minutes
        memory = '16g'
        cpus = 2
        clusterOptions = gpu_options
    }

    withName: BOLTZGEN_DESIGN_FOLDING {
        accelerator = 1
        time = 30.minutes
        memory = '16g'
        cpus = 2
        clusterOptions = gpu_options
    }

    withName: BOLTZGEN_MERGE {
        executor = 'local'
        time = 30.minutes
        memory = '1g'
        cpus = 1
    }

    withName: BOLTZGEN_ANALYSIS {
        time = 30.minutes
        memory = '64g'
        cpus = 8
        clusterOptions = gpu_options
    }

    withName: BOLTZGEN_FILTERING {
        time = 30.minutes
        memory = '4g'
        cpus = 1
        clusterOptions = gpu_options
    }

    // FoldSeek processes
    withName: FOLDSEEK_DOWNLOAD_DB {
        executor = 'local'
        time = 2.hours
        memory = '8g'
        cpus = 2
    }

    withName: FOLDSEEK_PREPARE_QUERIES {
        time = 30.minutes
        memory = '4g'
        cpus = 2
    }

    withName: FOLDSEEK_LOCAL_SEARCH {
        time = 4.hours
        memory = '16g'
        cpus = 8
    }

    withName: FOLDSEEK_REMOTE_SEARCH {
        executor = 'local'
        time = 2.hours
        memory = '4g'
        cpus = 1
    }

    withName: FOLDSEEK_DOWNLOAD_CATH_NAMES {
        executor = 'local'
        time = 30.minutes
        memory = '1g'
        cpus = 1
        errorStrategy = 'ignore'
    }

    withName: FOLDSEEK_ANNOTATE_CATH {
        time = 30.minutes
        memory = '4g'
        cpus = 2
        errorStrategy = 'ignore'
    }
}

// Apptainer specific settings
apptainer {
    enabled = true
    autoMounts = true
    pullTimeout = 3.hours

    // --nv to enable NVIDIA GPU support    
    runOptions = "--nv --cleanenv --env PYTHONNOUSERSITE=1 -B \$HOME -B /scratch2 -B /fs04"
    // runOptions = "--nv -B /scratch2 -B /fs04 -B /mnt/reference2/alphafold/alphafold_20240229:/app/dl_binder_design/af2_initial_guess/model_weights"
    // -B ${params.models_basepath}:/models
    envWhitelist = ['BOLTZ_CACHE']
}
