/*
 * This is a configuration specific to users of the M3 / MASSIVE HPC cluster at Monash University.
 */

includeConfig "${projectDir}/conf/platforms/monash_containers.config"

params.slurm_account = false

def account_option = (params.slurm_account ? " --account=${params.slurm_account}" : '')
def exclude_option = ' --exclude=m3t100'
def common_options = "${account_option}${exclude_option}"

def gpu_options = "--gres=gpu:1 --partition=gpu ${common_options}"
def gpu_m3h_options = "--gres=gpu:1 --partition=m3h --qos=m3h ${common_options}"
def gpu_bdi_options = "--gres=gpu:1 --partition=bdi --qos=bdiq ${common_options}"
def cpu_short_options = "--partition=comp --qos=shortq ${common_options}"
def cpu_comp_options = "--partition=comp ${common_options}"
def cpu_genomics_options = "--partition=genomics --qos=genomics ${common_options}"

def random_choice(choices) {
    return choices[new Random().nextInt(choices.size())]
}

executor {
    $slurm {
        queueSize = 200
        pollInterval = '30 sec'
        queueStatInterval = '10m'
    }
}

process {
    executor = 'slurm'
    stageInMode = 'symlink'
    errorStrategy = 'retry'
    maxRetries = 1
    cache = 'lenient'

    withName: UNIQUE_ID {
        executor = 'local'
    }

    withName: GET_CONTIGS {
        //container = params.containers.get_contigs
        executor = 'local'
    }

    withName: RENUMBER_RESIDUES {
        //container = params.containers.renumber_residues
        executor = 'local'
    }

    withName: FILTER_DESIGNS {
        executor = 'local'
    }

    withName: RFD3_FILTER_DESIGNS {
        executor = 'local'
    }

    withName: 'COMBINE_RFD3_SCORES' {
        executor = 'local'
    }

    withName: AF2IG_SCORE_FILTER {
        executor = 'local'
    }

    withName: COMBINE_SCORES {
        //container = params.containers.combine_scores
        executor = 'local'
    }

    withName: RFDIFFUSION {
        //container = params.containers.rfdiffusion

        // GPU partition
        clusterOptions = gpu_options

        // H100-80G
        // clusterOptions = gpu_m3h_options

        // BDI: A100/A40
        // clusterOptions = gpu_bdi_options

        time = 2.hours
        accelerator = 1

        memory = '64g'
        cpus = 16
    }

    withName: RFDIFFUSION_PARTIAL {
        //container = params.containers.rfdiffusion

        // GPU partition
        clusterOptions = gpu_options

        // H100-80G
        // clusterOptions = gpu_m3h_options

        // BDI: A100/A40
        // clusterOptions = gpu_bdi_options

        time = 30.minutes
        accelerator = 1
        memory = '64g'
        cpus = 16
    }

    withName: GENERATE_RFD3_CONFIG {
        executor = 'local'
    }

    withName: RFDIFFUSION3 {
        accelerator = 1
        clusterOptions = gpu_options
        time = 2.hours
        memory = '32g'
        cpus = 2
    }

    withName: MPNN {
        clusterOptions = cpu_short_options
        time = 30.minutes
        memory = '4g'
        cpus = 1
    }

    withName: ROSETTAFOLD3 {
        accelerator = 1
        clusterOptions = gpu_options
        time = { 15.minutes * Math.max(1, (params.rf3_batch_size ?: 1) as int) }
        memory = '64g'
        cpus = 2
    }

    withName: RFD3_RMSD {
        executor = 'local'
    }

    withName: DL_BINDER_DESIGN_PROTEINMPNN {
        //container = params.containers.dl_binder_design_proteinmpnn

        // CPU only
        // clusterOptions = cpu_genomics_options
        clusterOptions = cpu_short_options
        time = 30.minutes

        memory = '4g'
        cpus = 1
    }

    withName: AF2_INITIAL_GUESS {
        //container = params.containers.af2_initial_guess
        accelerator = 1

        // GPU partition
        clusterOptions = gpu_options

        // H100-80G
        // clusterOptions = gpu_m3h_options

        // BDI: A100/A40
        // clusterOptions = gpu_bdi_options

        time = 2.hours

        memory = '64g'
        cpus = 16
    }

    withName: ALPHAFOLD2_JACKHMMER_MSA {
        // comp partition - do NOT use --qos=shortq, it caps at 30 min and the
        // full_dbs MSA/feature-generation stage needs hours for large targets.
        clusterOptions = '--partition=comp' + (params.slurm_account ? " --account=${params.slurm_account} " : '')
        time = 8.hours
        memory = '64g'
        cpus = 8
    }

    withName: ALPHAFOLD2 {
        accelerator = 1
        // No L40S exclusion here - unlike the older CUDA-11 AF2 containers
        // elsewhere in this pipeline, this CUDA-12 custom build requires
        // L40S-class (or newer) GPUs; see plans/on-this-new-branch-groovy-moonbeam.md.
        clusterOptions = '--gres=gpu:1 --partition=gpu' + (params.slurm_account ? " --account=${params.slurm_account} " : '')
        time = 2.hours
        memory = '64g'
        cpus = 4
    }

    withName: CREATE_BOLTZ_YAML {
        executor = 'local'
    }

    withName: PARSE_BOLTZ_CONFIDENCE_JSON {
        executor = 'local'
    }

    withName: BOLTZ_PULLDOWN_REPORTING {
        executor = 'local'
    }

    withName: FOLD_PULLDOWN_REPORTING {
        executor = 'local'
    }

    withName: FOLD_PULLDOWN_MERGE_SCORES {
        executor = 'local'
    }

    withName: SINGLE_SEQ_A3M {
        executor = 'local'
        cpus = 1
        memory = '1g'
    }

    withName: FOLD_ASSEMBLE_AF2_MULTIMER_MSAS {
        executor = 'local'
        cpus = 1
        memory = '8g'
    }

    withName: 'MMSEQS_COLABFOLDSEARCH|MMSEQS_TARGET|MMSEQS_BINDER' {
        // comp partition
        clusterOptions = cpu_comp_options
        // 128g/16cpu is the ceiling for a LOCAL colabfold_search over the indexed
        // uniref30+envdb DBs (~95g for the prefilter step, verified 2026-07-18).
        // With --use_remote_server the process just POSTs to the ColabFold API and
        // polls, so that request is pure queue delay: on a busy comp partition a
        // 16cpu/128g ask sat PENDING ~10h while a 2cpu/8g ask starts almost at once.
        time = (params.use_remote_server ?: false) ? 2.hours : 4.hours
        memory = (params.use_remote_server ?: false) ? '8g' : '128g'
        cpus = (params.use_remote_server ?: false) ? 2 : 16

    // genomics partition
    // clusterOptions = cpu_genomics_options
    //time = 4.hours
    //memory = '128g' // '360g'
    //cpus = 24       // 48
    // Load index into RAM
    //ext.args = "--db-load-mode 2"
    }

    withName: BOLTZ {
        accelerator = 1

        // GPU partition
        clusterOptions = gpu_options

        // BDI: A100/A40
        // clusterOptions = gpu_bdi_options

        time = 1.hours
        memory = '64g'
        cpus = 2
    }

    withName: 'BOLTZ_PULLDOWN:BOLTZ' {
        accelerator = 1

        // GPU partition
        clusterOptions = gpu_options

        // BDI: A100/A40
        // clusterOptions = gpu_bdi_options

        time = 1.hours
        memory = '64g'
        cpus = 2
    }


    withName: BOLTZ_COMPARE_COMPLEX {
        accelerator = 1

        // GPU partition
        clusterOptions = gpu_options

        // BDI: A100/A40
        // clusterOptions = gpu_bdi_options

        time = 2.hours
        memory = '64g'
        cpus = 2
    }

    withName: BOLTZ_COMPARE_BINDER_MONOMER {
        accelerator = 1

        // GPU partition
        clusterOptions = gpu_options

        // BDI: A100/A40
        // clusterOptions = gpu_bdi_options

        time = 1.hours
        memory = '64g'
        cpus = 2
    }

    // fold.nf (see plans/fold-nf-multi-method-folding.md) - new processes only;
    // MMSEQS_COLABFOLDSEARCH, ALPHAFOLD2*, BOLTZ selectors above are reused as-is.
    withName: COLABFOLD_A3M_TO_AF2_MSAS {
        executor = 'local'
    }

    withName: AF2_MSAS_TO_A3M {
        executor = 'local'
    }

    withName: FOLD_CREATE_BOLTZ_YAML {
        executor = 'local'
    }

    withName: FOLD_PARSE_BOLTZ_CONFIDENCE {
        executor = 'local'
    }

    // cpus=1 is the right default for these trivial local helpers; a
    // fully-qualified selector wins over the broad `withName: 'BOLTZ_.*'`
    // (cpus=2) that otherwise matches their BOLTZ_FOLD:... names. See nextflow.config.
    withName: 'BOLTZ_FOLD:FOLD_CREATE_BOLTZ_YAML' {
        executor = 'local'
        cpus = 1
    }
    withName: 'BOLTZ_FOLD:FOLD_CREATE_BOLTZ_YAML_COMPLEX' {
        executor = 'local'
        cpus = 1
    }
    withName: 'BOLTZ_FOLD:FOLD_PARSE_BOLTZ_CONFIDENCE' {
        executor = 'local'
        cpus = 1
    }

    // fold.nf score-TSV helpers (parse confidence -> TSV, AF2 ipSAE, master
    // merge): trivial CPU tasks, run local (avoid a SLURM queue wait for a
    // seconds-long parse). See nextflow.config.
    withName: 'ALPHAFOLD2:FOLD_SCORE_AF2' {
        executor = 'local'
        cpus = 1
    }
    withName: '.*:FOLD_PARSE_CONFIDENCE' {
        executor = 'local'
        cpus = 1
    }
    withName: 'FOLD_MERGE_SCORES' {
        executor = 'local'
        cpus = 1
    }

    withName: ENGENS_STAGE_STRUCTURE {
        executor = 'local'
    }

    withName: ENGENS {
        // CPU-only Quarto + EnGens report; no GPU.
        clusterOptions = '--partition=comp' + (params.slurm_account ? " --account=${params.slurm_account} " : '')
        time = 2.hours
        memory = '16g'
        cpus = 4
    }

    withName: 'BOLTZ_FOLD:BOLTZ' {
        accelerator = 1
        clusterOptions = '--gres=gpu:1 --partition=gpu' + (params.slurm_account ? " --account=${params.slurm_account} " : '')
        time = 1.hours
        memory = '64g'
        cpus = 2
    }

    withName: GENERATE_RF3_FOLD_INPUT {
        executor = 'local'
    }

    withName: RF3_FOLD {
        accelerator = 1
        clusterOptions = '--gres=gpu:1 --partition=gpu' + (params.slurm_account ? " --account=${params.slurm_account} " : '')
        time = { 15.minutes * Math.max(1, (params.rf3_batch_size ?: params.n_predictions ?: 5) as int) }
        memory = '64g'
        cpus = 2
    }

    withName: GENERATE_PROTENIX_INPUT {
        executor = 'local'
    }

    // See nextflow.config's matching selector comment - PROTENIX_FOLD_PROCESS
    // is the include alias for modules/local/protenix/protenix_fold.nf's
    // PROTENIX_FOLD process (aliased to avoid colliding with the wrapping
    // PROTENIX_FOLD subworkflow name).
    withName: PROTENIX_FOLD_PROCESS {
        accelerator = 1
        clusterOptions = '--gres=gpu:1 --partition=gpu' + (params.slurm_account ? " --account=${params.slurm_account} " : '')
        time = 1.hours
        memory = '64g'
        cpus = 2
    }

    withName: BINDCRAFT_CREATE_SETTINGS {
        executor = 'local'
    }

    withName: BINDCRAFT {
        accelerator = 1
        time = 2.hours
        memory = '16g'
        cpus = 2

        // GPU partition
        clusterOptions = gpu_options

        // BDI: A100/A40
        // clusterOptions = gpu_bdi_options
    }

    withName: /^(GERMINAL|GERMINAL_PROCESS)$/ {
        accelerator = 1
        time = 24.hours
        memory = '48g'
        cpus = 8
        clusterOptions = gpu_options
    }

    withName: GERMINAL_MERGE {
        executor = 'local'
        time = 30.minutes
        memory = '1g'
        cpus = 1
    }

    withName: BOLTZGEN_DESIGN {
        accelerator = 1
        time = 30.minutes
        memory = '16g'
        cpus = 2
        clusterOptions = gpu_options
    }

    withName: BOLTZGEN_INVERSE_FOLDING {
        accelerator = 1
        time = 30.minutes
        memory = '8g'
        cpus = 2
        clusterOptions = gpu_options
    }

    withName: BOLTZGEN_FOLDING {
        accelerator = 1
        time = 30.minutes
        memory = '16g'
        cpus = 2
        clusterOptions = gpu_options
    }

    withName: BOLTZGEN_DESIGN_FOLDING {
        accelerator = 1
        time = 30.minutes
        memory = '16g'
        cpus = 2
        clusterOptions = gpu_options
    }

    withName: BOLTZGEN_MERGE {
        executor = 'local'
        time = 30.minutes
        memory = '1g'
        cpus = 1
    }

    withName: BOLTZGEN_ANALYSIS {
        time = 30.minutes
        memory = '64g'
        cpus = 8
        clusterOptions = gpu_options
    }

    withName: BOLTZGEN_FILTERING {
        time = 30.minutes
        memory = '4g'
        cpus = 1
        clusterOptions = gpu_options
    }

    // FoldSeek processes
    withName: FOLDSEEK_DOWNLOAD_DB {
        executor = 'local'
        time = 2.hours
        memory = '8g'
        cpus = 2
    }

    withName: FOLDSEEK_PREPARE_QUERIES {
        time = 30.minutes
        memory = '4g'
        cpus = 2
    }

    withName: FOLDSEEK_LOCAL_SEARCH {
        time = 4.hours
        memory = '16g'
        cpus = 8
    }

    withName: FOLDSEEK_REMOTE_SEARCH {
        executor = 'local'
        time = 2.hours
        memory = '4g'
        cpus = 1
    }

    withName: FOLDSEEK_DOWNLOAD_CATH_NAMES {
        executor = 'local'
        time = 30.minutes
        memory = '1g'
        cpus = 1
        errorStrategy = 'ignore'
    }

    withName: FOLDSEEK_ANNOTATE_CATH {
        time = 30.minutes
        memory = '4g'
        cpus = 2
        errorStrategy = 'ignore'
    }
}

// Apptainer specific settings
apptainer {
    enabled = true
    autoMounts = true
    pullTimeout = 3.hours

    // --nv to enable NVIDIA GPU support
    // Both AlphaFold trees must be bound. Inside
    // /mnt/datasets/alphafold/alphafold_<date>/, the entries bfd, mgnify, pdb70,
    // uniclust30 and uniref90 are SYMLINKS into /mnt/reference/alphafold/; only
    // params, pdb_mmcif, pdb_seqres and uniprot are real directories there. Binding
    // /mnt/datasets alone leaves those paths dangling inside the container, and AF2
    // fails on an existence check for a path that `ls` happily on the host.
    runOptions = "--nv --cleanenv --env PYTHONNOUSERSITE=1 -B \$HOME -B /scratch2 -B /fs04 -B /mnt/datasets/alphafold -B /mnt/reference/alphafold"
    // runOptions = "--nv -B /scratch2 -B /fs04 -B /mnt/reference2/alphafold/alphafold_20240229:/app/dl_binder_design/af2_initial_guess/model_weights"
    // -B ${params.models_basepath}:/models
    envWhitelist = ['BOLTZ_CACHE']
}

// AlphaFold2 sequence databases on M3.
//
// These are NOT the model weights: alphafold2:2.3.2-custom bundles those, and
// params.af2_data_dir defaults to /app/alphafold inside the container.
//
// They are required as *flags* regardless of --msa_method, because
// run_alphafold.py builds the full data pipeline even under
// --use_precomputed_msas and the tool constructors existence-check their paths
// (jackhmmer.py:76, hhblits.py:84, hmmsearch.py:71, templates.py:950, and -
// monomer presets only, so --methods af2_mono - hhsearch.py:61). They are never
// read when MSAs come from ColabFold, only stat'd.
//
// The 2021 snapshot is the one with the multimer-era pdb_seqres/uniprot layout.
params {
    af2_db_path = '/mnt/datasets/alphafold/alphafold_20211129'
    af2_uniref30_subpath = 'uniclust30/uniclust30_2018_08/uniclust30_2018_08'
    af2_mgnify_subpath = 'mgnify/mgy_clusters_2018_12.fa'
    af2_uniprot_subpath = 'uniprot/uniprot.fasta'
    af2_pdb_seqres_subpath = 'pdb_seqres/pdb_seqres.txt'
    af2_pdb70_subpath = 'pdb70/pdb70'
}
