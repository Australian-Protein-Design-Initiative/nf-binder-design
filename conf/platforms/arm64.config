/*
 * arm64 / aarch64 workstations (eg NVIDIA DGX Spark GB10).
 *
 * Most of the pipeline's images are published for linux/amd64 only, so on an arm64 host their
 * tasks die immediately with `exec /bin/bash: exec format error`. This config points the affected
 * processes at the arm64 builds in the APDI containers registry.
 *
 * Use it alongside a runtime config, eg:
 *   nextflow run main.nf -c conf/platforms/arm64.config -c nextflow.docker.config ...
 *
 * Coverage is deliberately partial. Only the images needed for the RFD4-Proteina design path and
 * its scoring have arm64 builds so far:
 *
 *   nf-binder-design-utils   0.1.7-arm64
 *   boltz                    v2.2.1-2_nv-cuda13-arm64
 *   foldseek                 10-941cd33-arm64
 *   rfd4-proteina            already arm64 in the module definitions
 *
 * Anything else - AlphaFold2, AF3, Protenix, Chai-1, RosettaFold3, OpenFold3, BindCraft, Germinal,
 * BoltzGen, ESMFold2 - has no arm64 image, so those methods still fail here. In particular
 * --refold_oracles accepts engines that cannot run on this platform; boltz is the one that can.
 *
 * The process lists are explicit rather than a wildcard because the container is set per module,
 * and a wildcard would also capture the processes that are correctly pinned elsewhere. When a
 * module is added that uses one of these images, its process name has to be added here too.
 */

// Note: upstream's FoldSeek GPU build is x86_64 only, so FoldSeek runs on CPU here. The pipeline
// uses CPU searches anyway, so this is a difference in speed rather than in what works.

params {
    // Boltz's dataloader workers deadlock on this platform: the run reaches "Predicting: 0/?",
    // then sits at 0% GPU indefinitely rather than failing. Verified against this image - with
    // workers it hangs past 20 minutes, with 0 it predicts in seconds. RFD4-Proteina needs the
    // same treatment, hence --rfd4_num_workers 0.
    boltz_num_workers = 0
    rfd4_num_workers = 0
}

// These images switch to an account of their own, whose uid does not match the host user that
// owns the work directory, so a task cannot write its own output and dies on `.command.trace`.
// Apptainer hides this by running as the invoking user; under Docker it has to be asked for.
// Set here rather than in the images, so the arm64 builds stay identical to their amd64 siblings.
// Written out in each block rather than held in a `def`: a variable declaration in a config file
// cannot be mixed with config statements under the Nextflow 26 parser.
//
// Note that the per-process `containerOptions` is used rather than a global `docker.runOptions`:
// a runtime config such as the examples' nextflow.docker.config sets runOptions itself, and
// whichever -c comes last would win. containerOptions is added to runOptions, not a replacement
// for it, so --gpus all from that config still applies.
process {

    withName: 'AF2IG_SCORE_FILTER|ANNOTATE_MSA|BINDCRAFT_CREATE_SETTINGS|BINDCRAFT_REPORTING|COMBINE_RFD3_SCORES|COMBINE_RFD4_SCORES|COMBINE_SCORES|FILTER_DESIGNS|FOLD_CREATE_BOLTZ_YAML|FOLD_CREATE_BOLTZ_YAML_COMPLEX|FOLD_MERGE_SCORES|FOLD_PARSE_BOLTZ_CONFIDENCE|FOLD_PARSE_CONFIDENCE|FOLD_PULLDOWN_MERGE_SCORES|FOLD_PULLDOWN_REPORTING|FOLD_SCORE_AF2|FOLDSEEK_ANNOTATE_CATH|FOLDSEEK_PREPARE_QUERIES|GENERATE_AF3_INPUT|GENERATE_AF3_INPUT_COMPLEX|GENERATE_ESMFOLD2_INPUT_COMPLEX|GENERATE_OPENFOLD3_INPUT|GENERATE_OPENFOLD3_INPUT_COMPLEX|GENERATE_PROTENIX_INPUT|GENERATE_PROTENIX_INPUT_COMPLEX|GENERATE_RF3_FOLD_INPUT|GENERATE_RF3_FOLD_INPUT_COMPLEX|GENERATE_RF3_INPUT_JSON|GERMINAL_MERGE|GET_CONTIGS|MATCH_FOLD_TEMPLATES|PDB_TO_FASTA|PREPARE_RF3_TEMPLATE|PREPARE_RFD4_INPUT|REFOLD_ORACLE_SCORES_WIDE|REFOLD_PREPARE_ORACLE_INPUTS|RENUMBER_RESIDUES|RFD3_RMSD|RMSD4ALL|SINGLE_SEQ_A3M|SPLIT_COMPLEX_FASTA|TRIM_TO_CONTIGS' {
        container = 'ghcr.io/australian-protein-design-initiative/containers/nf-binder-design-utils:0.1.7-arm64'
        containerOptions = "-u \$(id -u):\$(id -g)"
    }

    withName: 'BOLTZ|BOLTZ_COMPARE_BINDER_MONOMER|BOLTZ_COMPARE_COMPLEX' {
        container = 'ghcr.io/australian-protein-design-initiative/containers/boltz:v2.2.1-2_nv-cuda13-arm64'
        containerOptions = "-u \$(id -u):\$(id -g)"
    }

    // Pulled in by --full_refold_with boltz, which scores the refolded complex with BindCraft's
    // interface metrics. This tag is an existing arm64 build rather than one added alongside the
    // others here, so it is a different BindCraft revision from the amd64 default.
    withName: 'BINDCRAFT_SCORING' {
        container = 'ghcr.io/australian-protein-design-initiative/containers/bindcraft:nv-cuda13-arm64'
        // Unlike the amd64 tag, this image sets an ENTRYPOINT of bindcraft.py, which would
        // swallow the command Nextflow appends and fail with "the following arguments are
        // required: --settings". The paths the scoring script expects - the BindCraft conda
        // python, DAlphaBall.gcc and dssp - are the same in both images.
        containerOptions = '--entrypoint ""'
    }

    withName: 'FOLDSEEK_DOWNLOAD_CATH_NAMES|FOLDSEEK_DOWNLOAD_DB|FOLDSEEK_LOCAL_SEARCH|FOLDSEEK_REMOTE_SEARCH' {
        container = 'ghcr.io/australian-protein-design-initiative/containers/foldseek:10-941cd33-arm64'
        // Runs as root otherwise, which leaves root-owned files in the work and output dirs.
        containerOptions = "-u \$(id -u):\$(id -g)"
    }
}
