/*
 * arm64 / aarch64 workstations (eg NVIDIA DGX Spark GB10).
 *
 * Most of the pipeline's images are published for linux/amd64 only, so on an arm64 host their
 * tasks die immediately with `exec /bin/bash: exec format error`. This config points the affected
 * processes at the arm64 builds in the APDI containers registry.
 *
 * Use it alongside a runtime config, eg:
 *   nextflow run main.nf -c conf/platforms/arm64.config -c nextflow.docker.config ...
 *
 * Coverage is deliberately partial. These images have arm64 builds so far:
 *
 *   nf-binder-design-utils   0.1.7-arm64
 *   boltz                    v2.2.1-2_nv-cuda13-arm64
 *   esmfold2                 3.4.1.post1_nv-cuda13-arm64_{fast,full}_weights
 *   rc-foundry (RF3)         0.2.0_arm64-weights-ngc2606
 *   bindcraft                nv-cuda13-arm64
 *   foldseek                 10-941cd33-arm64
 *   rfd4-proteina            0.0.3-aaccdd2_nv-cuda13-arm64
 *   protenix                 2026-09-21_85767b8_nv-cuda13-arm64_weights
 *
 * Anything else - AlphaFold2, AF3, Chai-1, OpenFold3, Germinal, BoltzGen - has no arm64 image, so
 * those methods still fail here. In particular --full_refold_with accepts engines that cannot run
 * on this platform; boltz, esmfold2, esmfold2_fast, rf3 and protenix are the ones that can.
 *
 * rf3 needs the -ngc2606 tag specifically, not the plain 0.2.0_arm64-weights one. That build is
 * on NGC pytorch 25.01 (CUDA 12.8), whose nvrtc cannot target sm_121, and PyTorch's jiterator
 * compiles erfinv for the exact device architecture, so on a GB10 model construction dies with
 *   nvrtc: error: invalid value for --gpu-architecture (-arch)
 * once the weights have loaded. Everything else JITs from that image's compute_120 PTX and is
 * unaffected, which is why only RF3 shows it. -ngc2606 is the same rc-foundry release on NGC
 * pytorch 26.06 (CUDA 13.3), with the cuequivariance ops swapped to their cu13 builds.
 *
 * The process lists are explicit rather than a wildcard because the container is set per module,
 * and a wildcard would also capture the processes that are correctly pinned elsewhere. When a
 * module is added that uses one of these images, its process name has to be added here too.
 */

// Note: upstream's FoldSeek GPU build is x86_64 only, so FoldSeek runs on CPU here. The pipeline
// uses CPU searches anyway, so this is a difference in speed rather than in what works.

params {
    // Boltz's dataloader workers deadlock on this platform: the run reaches "Predicting: 0/?",
    // then sits at 0% GPU indefinitely rather than failing. Verified against this image - with
    // workers it hangs past 20 minutes, with 0 it predicts in seconds. RFD4-Proteina needs the
    // same treatment, hence --rfd4_num_workers 0.
    boltz_num_workers = 0
    rfd4_num_workers = 0

    // Without gpu_devices set, bin/gpu_lock.sh never engages and GPU tasks run concurrently on
    // the one device. On a GB10, whose 128 GB is shared between host and GPU, two fold models
    // resident at once is enough to OOM. 'all' rather than '0' so a multi-card arm64 host still
    // uses every device; one slot per device serialises the fold models on each.
    gpu_devices = 'all'
    gpu_slots_per_device = 1
}

// These images switch to an account of their own, whose uid does not match the host user that
// owns the work directory, so a task cannot write its own output and dies on `.command.trace`.
// Apptainer hides this by running as the invoking user; under Docker it has to be asked for.
// Set here rather than in the images, so the arm64 builds stay identical to their amd64 siblings.
// Written out in each block rather than held in a `def`: a variable declaration in a config file
// cannot be mixed with config statements under the Nextflow 26 parser.
//
// Note that the per-process `containerOptions` is used rather than a global `docker.runOptions`:
// a runtime config such as the examples' nextflow.docker.config sets runOptions itself, and
// whichever -c comes last would win. containerOptions is added to runOptions, not a replacement
// for it, so --gpus all from that config still applies.
process {

    withName: 'AF2IG_SCORE_FILTER|ANNOTATE_MSA|BINDCRAFT_CREATE_SETTINGS|BINDCRAFT_REPORTING|COMBINE_RFD3_SCORES|COMBINE_RFD4_SCORES|COMBINE_SCORES|FILTER_DESIGNS|FOLD_CREATE_BOLTZ_YAML|FOLD_CREATE_BOLTZ_YAML_COMPLEX|FOLD_MERGE_SCORES|FOLD_PARSE_BOLTZ_CONFIDENCE|FOLD_PARSE_CONFIDENCE|FOLD_PULLDOWN_MERGE_SCORES|FOLD_PULLDOWN_REPORTING|FOLD_SCORE_AF2|FOLDSEEK_ANNOTATE_CATH|FOLDSEEK_PREPARE_QUERIES|GENERATE_AF3_INPUT|GENERATE_AF3_INPUT_COMPLEX|GENERATE_ESMFOLD2_INPUT_COMPLEX|GENERATE_OPENFOLD3_INPUT|GENERATE_OPENFOLD3_INPUT_COMPLEX|GENERATE_PROTENIX_INPUT|GENERATE_PROTENIX_INPUT_COMPLEX|GENERATE_RF3_FOLD_INPUT|GENERATE_RF3_FOLD_INPUT_COMPLEX|GENERATE_RF3_INPUT_JSON|GERMINAL_MERGE|GET_CONTIGS|MATCH_FOLD_TEMPLATES|PDB_TO_FASTA|PREPARE_RF3_TEMPLATE|PREPARE_RFD4_INPUT|REFOLD_COMPARE_COMPLEX|REFOLD_COMPARE_MONOMER|REFOLD_PREPARE_INPUTS|REFOLD_SAMPLE_SCORES|REFOLD_SCORES_WIDE|REFOLD_STRUCTURE_TO_PDB|RENUMBER_RESIDUES|RFD3_RMSD|RMSD4ALL|SINGLE_SEQ_A3M|SPLIT_COMPLEX_FASTA|TRIM_TO_CONTIGS' {
        container = 'ghcr.io/australian-protein-design-initiative/containers/nf-binder-design-utils:0.1.7-arm64'
        containerOptions = "-u \$(id -u):\$(id -g)"
    }

    withName: 'BOLTZ|BOLTZ_COMPARE_BINDER_MONOMER|BOLTZ_COMPARE_COMPLEX' {
        container = 'ghcr.io/australian-protein-design-initiative/containers/boltz:v2.2.1-2_nv-cuda13-arm64'
        containerOptions = "-u \$(id -u):\$(id -g)"
    }

    // Pulled in by --full_refold_with boltz, which scores the refolded complex with BindCraft's
    // interface metrics. This tag is an existing arm64 build rather than one added alongside the
    // others here, so it is a different BindCraft revision from the amd64 default.
    withName: 'BINDCRAFT_SCORING' {
        container = 'ghcr.io/australian-protein-design-initiative/containers/bindcraft:nv-cuda13-arm64'
        // Unlike the amd64 tag, this image sets an ENTRYPOINT of bindcraft.py, which would
        // swallow the command Nextflow appends and fail with "the following arguments are
        // required: --settings". The paths the scoring script expects - the BindCraft conda
        // python, DAlphaBall.gcc and dssp - are the same in both images.
        containerOptions = '--entrypoint ""'
    }

    // --full_refold_with esmfold2 / esmfold2_fast. One process serves both engines and picks its
    // image from meta.esmfold2_tool, so the container is a closure here too - config directive
    // closures are resolved against the task's input variables, meta among them.
    withName: 'ESMFOLD2|ESMFOLD2_PROCESS|ESMFOLD2_FAST_PROCESS' {
        container = { "ghcr.io/australian-protein-design-initiative/containers/esmfold2:3.4.1.post1_nv-cuda13-arm64_${meta.esmfold2_tool == 'esmfold2_fast' ? 'fast' : 'full'}_weights" }
    }

    // --full_refold_with rf3. The amd64 module names an oras:// SIF, which Docker cannot pull,
    // so this is the OCI tag of the same release rather than only an architecture swap.
    // The -ngc2606 build, not the plain arm64 one: see the nvrtc note in the header.
    withName: 'RF3_FOLD' {
        container = 'ghcr.io/australian-protein-design-initiative/containers/rc-foundry:0.2.0_arm64-weights-ngc2606'
        containerOptions = "-u \$(id -u):\$(id -g)"
    }

    // --full_refold_with protenix. Selector uses the PROTENIX_FOLD_PROCESS include alias rather
    // than the process's declared name PROTENIX_FOLD, matching nextflow.config and
    // monash_containers.config.
    //
    // Protenix's fused layer-norm is a CUDA extension compiled at image build time, and upstream
    // builds it for sm_70 to sm_100 only, so on a GB10 (sm_121) inference died with "no kernel
    // image is available for execution on the device". This tag is built from a Dockerfile that
    // adds sm_120 and sm_121 to that list; the plain amd64 tag is unaffected because no amd64
    // card reports those architectures.
    withName: PROTENIX_FOLD_PROCESS {
        container = 'ghcr.io/australian-protein-design-initiative/containers/protenix:2026-09-21_85767b8_nv-cuda13-arm64_weights'
        // HOME as well as the uid: Protenix caches under $HOME/.cache, and with only -u set HOME
        // is unset inside the container, so it resolves to / and the run dies with
        // "PermissionError: [Errno 13] Permission denied: '/.cache'". Apptainer does not show
        // this because it binds the invoking user's home.
        containerOptions = "-u \$(id -u):\$(id -g) -e HOME=/tmp"
    }

    // The module definitions name the amd64 tag; this swaps in its arm64 sibling.
    withName: 'RFD4_GENERATE|PARSE_RFD4_CONFIG' {
        container = 'ghcr.io/australian-protein-design-initiative/containers/rfd4-proteina:0.0.3-aaccdd2_nv-cuda13-arm64'
    }

    withName: 'FOLDSEEK_DOWNLOAD_CATH_NAMES|FOLDSEEK_DOWNLOAD_DB|FOLDSEEK_LOCAL_SEARCH|FOLDSEEK_REMOTE_SEARCH' {
        container = 'ghcr.io/australian-protein-design-initiative/containers/foldseek:10-941cd33-arm64'
        // Runs as root otherwise, which leaves root-owned files in the work and output dirs.
        containerOptions = "-u \$(id -u):\$(id -g)"
    }
}
