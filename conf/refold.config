/*
 * Refold scoring defaults, shared by every design workflow.
 *
 * Refolding is the held-out second opinion on a design: the pipeline has already
 * cofolded it once with its own predictor (AF2 initial guess in rfd and rfd_partial,
 * RF3 in rfd3, BindCraft's and Germinal's own AF2 passes), and REFOLD folds a chosen
 * subset again with one or more independent predictors, compares the result with the
 * design, and scores the rebuilt interface.
 *
 * These live in config rather than in each workflow script because Nextflow does not
 * evaluate top-level `params.x = ...` in an included script, so the REFOLD subworkflow
 * cannot declare its own, and copying the block into six workflows is how they drift
 * apart. Every name here is refold_-prefixed and no workflow entrypoint declares one
 * under a different default, so there is nothing for a config declaration to override.
 *
 * The unprefixed fold-stack parameters (--n_predictions, --msa_method, --af2_*,
 * --protenix_*) are deliberately NOT here: workflows/fold.nf wants different values
 * for several of them (af2_keep_models 'best' rather than 'all', monomer rather than
 * multimer), and a config declaration beats a workflow script's default, so moving
 * them here would silently change what --method fold does. Each design workflow
 * declares its own copies.
 *
 * A workflow still declares two of its own, because they differ per workflow and a
 * config value could not be overridden:
 *
 *   params.refold_publish_dir   where the refold's tables and structures land
 *   params.fold_publish_dir     kept equal to it; the fold modules read it directly
 */

params {

    // --- what to refold with ---

    // Comma-separated engine list, eg 'boltz' or 'boltz,esmfold2,chai1'. Empty means
    // no refolding at all, which is the default for every workflow: it is an extra
    // GPU-hours-per-design step on top of the pipeline's own cofold.
    refold_with = ''

    // --- which designs to refold (see subworkflows/local/refold_select.nf) ---

    // A threshold gate on the first cofold's scores, semicolon-separated, in the same
    // syntax as --rfd_filters and bin/filter_designs.py:
    //
    //   --refold_filter 'ipsae>=0.5;pae_interaction<=10'
    //
    // Per-design, so it streams: a design is refolded as soon as its own scores exist,
    // while the rest of the set is still being scored.
    refold_filter = false

    // Rank the designs that pass the gate by one metric before --refold_max takes the
    // best of them. A '-' prefix means descending, so '-ipsae' is "highest ipSAE
    // first"; metrics where low is good (pae_interaction, rmsd) need no prefix.
    //
    // Ranking cannot stream - the best N is not known until the last design is scored -
    // so this makes refolding wait for the whole design set.
    refold_sort_by = false

    // Cap on how many designs are refolded. With --refold_sort_by it takes the best N;
    // without it, the first N to arrive.
    refold_max = false

    // Which chain of the design is the binder and which is the target. Unset means the
    // workflow decides: rfd3 and rfd4_proteina derive it from the contigs or their own
    // --*_binder_chain, rfd and rfd_partial know it from how AF2 initial guess writes
    // its complexes. BindCraft and Germinal have no derivation of their own, so these
    // are how to correct them for a target that is not chain A.
    refold_binder_chain = false
    refold_target_chain = false

    // --- what the refold is folded against ---

    // The target to refold against, as a FASTA holding exactly one record. Unset
    // means the target the designs were built against, read back out of the target
    // chain of each design structure.
    //
    // This is the full-length / truncated knob. A design made against a trimmed
    // domain is refolded against that same trimmed domain unless this says
    // otherwise, and "does the binder still sit there in the whole protein" is a
    // different question from the one the design run answered. One record only:
    // the pulldown folds every binder against every target, and one row per design
    // in refold_scores.tsv depends on there being a single target, so comparing two
    // targets means two runs.
    //
    // The designs' own target is still read and checked: a warning says so when the
    // supplied sequence does not contain it, which is the usual sign that
    // --refold_target_chain or the FASTA is not what the run assumed. With a longer
    // target the design and the refold are no longer the same molecule, so the
    // whole-complex RMSD columns that need equal lengths (complex_rmsd_all,
    // complex_tm_score_all) come back as nan; the target-aligned binder RMSD, which
    // is the pose metric, is unaffected.
    refold_target_fasta = false

    // --- what the refold reports ---

    // The id given to the target chain in the refold's own FASTA and score tables,
    // whether the sequence came from the designs or from --refold_target_fasta.
    refold_target_id = 'target'

    refold_metrics = 'iptm_max,iptm_mean,ipsae_max,ipsae_mean,plddt_max,plddt_mean,ptm_max,pae_mean,n'

    // Several samples per design (--n_predictions > 1) reduce to one row per design.
    // The confidence columns are aggregates over the samples (iptm_max and friends).
    // The structural columns - RMSD against the design, and the interface metrics - are
    // not: they describe one set of coordinates, so they are all read from the single
    // best-ranked sample, by --consensus_metric. A statistic per metric would give a
    // row that no predicted structure matches, and the interface metrics have no shared
    // direction to take a best in anyway. min / mean / max / first still override it.
    // refold_sample_scores.tsv carries every sample's own values.
    refold_structure_stat = 'selected'

    // Fold the binder on its own as well, for the "does it hold its fold without the
    // target" comparison. Doubles the folding work, so it can be turned off.
    refold_binder_monomer = true
    refold_monomer_chain = 'A'
    refold_monomer_single_sequence = true

    refold_interface_scoring = true

    // DockQ, its fnat / iRMSD / LRMSD components, interface lDDT and a clash count for
    // the target-aligned binder comparison. On by default: it reads structures that
    // have already been written and needs no GPU, so it adds very little to a refold
    // that has just paid for the folding. Set false to drop the columns.
    refold_dockq = true

    refold_fasta_score_columns = 'consensus_z'

    // Keep the superimposed structures from the RMSD comparisons, for looking at.
    output_rmsd_aligned = false

    // The per-engine refold copies - refold_boltz_batch_size, refold_rf3_num_steps and
    // the rest - are deliberately NOT here, and each design workflow declares its own.
    // modules/local/fold/common/fold_params.nf picks the prefixed name over the plain one by asking
    // whether it is declared at all, so declaring them globally would have --method
    // fold and --method fold_pulldown read the refold's one-sample-per-job defaults
    // instead of their own.

    // --- renamed and removed parameters ---
    //
    // Declared so that a run using an old name fails with a message naming the new one
    // rather than Nextflow's generic "unknown parameter" warning, which is easy to miss
    // in a long log and leaves the run going with the default. Checked by
    // checkRefoldParamRenames() in modules/local/common/refold_select_utils.nf.
    refold_oracles = ''
    refold_oracles_max = false
    refold_oracle_metrics = false
    refold_oracle_target_id = false

    // --refold_af2ig_filters selected which AF2 initial guess designs rfd refolded.
    // --refold_filter does the same thing for every workflow.
    refold_af2ig_filters = false

    // Batched several designs into one Boltz refold comparison task, back when the
    // refold was a Boltz-specific pair of processes. The refold folds through the
    // shared fold stack now, where --refold_boltz_batch_size is samples per job.
    boltz_refold_batch_size = false

    // Refolding takes its MSA and template choices from the fold stack now, so these
    // have no equivalent of their own. Still read, to fail with a message naming the
    // fold-stack flag that replaced each one.
    refold_use_msa_server = false
    refold_create_target_msa = false
    refold_target_templates = false
    refold_alignment = false
}
