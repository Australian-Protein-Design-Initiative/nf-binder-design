/*
 * -profile af3_germinal_parity
 *
 * Run AlphaFold3 the way Germinal runs it, so an AF3 refold of Germinal designs
 * is comparable to the scores that run produced.
 *
 *   nextflow run main.nf --method fold_pulldown \
 *       --targets targets.fasta --binders binders.fasta --methods af3 \
 *       -profile slurm,m3,af3_germinal_parity \
 *       --af3_model_dir /path/to/af3_weights \
 *       --af3_db_dir /mnt/datasets/alphafold3/3.0.0
 *
 * Composes with any platform profile. This profile deliberately overrides the
 * platform's ALPHAFOLD3_PROCESS walltime: with the data pipeline on, AF3 runs a
 * template search over pdb_seqres/mmcif_files before inference, which the
 * platform formulas (sized for inference only) do not allow for. That override
 * holds whichever order the profiles are given in, because Nextflow merges
 * profiles in the order they are DECLARED in nextflow.config (feature profiles
 * are declared after the platform ones), not the order on the command line.
 *
 * See docs/docs/workflows/germinal.md#external-folding-validation for what this
 * reproduces, and fold.md#germinal-af3-parity for the parameter-by-parameter
 * mapping. Two things it does NOT reproduce, both left to the analysis side:
 * Germinal's seeds are random draws from [0, 999999), and Germinal keeps the
 * WORST of its sampled structures by ranking_score while this pipeline keeps
 * and scores all of them.
 */

params {
    // The three knobs that make AF3 behave as Germinal's call does: no
    // cross-chain pairing, no templates key so AF3 searches for its own, and the
    // data pipeline running so that search actually happens.
    af3_paired_msa = false
    af3_templates = 'search'
    af3_run_data_pipeline = true

    // Germinal's final fold: 5 seeds x 5 diffusion samples = 25 structures.
    // The seed VALUES are arbitrary (Germinal draws them randomly); the count is
    // what matters. A comma list suppresses the --n_predictions fan-out.
    af3_seeds = '1,2,3,4,5'
    af3_batch_size = 5
    af3_num_recycles = 10

    // Germinal's msa_mode: "target" - an MSA for the target chain only, binder
    // left single-sequence.
    create_target_msa = true
    create_binder_msa = false
    msa_method = 'mmseqs2_colabfold'
    use_remote_server = true
}

process {
    // ALPHAFOLD3_PROCESS, not ALPHAFOLD3: the subworkflow includes the process
    // under that alias, and a withName selector matches the name the process
    // runs under. Every platform config selects on the alias too.
    withName: ALPHAFOLD3_PROCESS {
        // The data pipeline's jackhmmer/hmmsearch template search is CPU-bound
        // and runs before inference, so a parity job needs more wall time and
        // more cores than an inference-only one.
        cpus = 8
        time = { 2.hours * task.attempt }
    }
}
